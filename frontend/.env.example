# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Socket.IO (usually same as API URL)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# PWA Configuration
NEXT_PUBLIC_APP_NAME=ArtiConnect
NEXT_PUBLIC_APP_DESCRIPTION=Plateforme de mise en relation entre clients et artisans

# Google Maps API Key (optional, for geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Stripe Public Key (for payments)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
