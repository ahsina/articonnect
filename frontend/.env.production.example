# ====================================
# ARTICONNECT - FRONTEND PRODUCTION CONFIG
# ====================================
# ⚠️ IMPORTANT: Never commit .env.production to Git!
# Copy this file to .env.production and fill in real values

# ====================================
# API CONFIGURATION
# ====================================
# Use your production API domain
NEXT_PUBLIC_API_URL=https://api.articonnect.lu

# Socket.IO URL (usually same as API)
NEXT_PUBLIC_SOCKET_URL=https://api.articonnect.lu

# ====================================
# APPLICATION INFO
# ====================================
NEXT_PUBLIC_APP_NAME=ArtiConnect
NEXT_PUBLIC_APP_DESCRIPTION=Plateforme de mise en relation entre clients et artisans
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=production

# ====================================
# GOOGLE SERVICES
# ====================================
# Google Maps API Key (with restrictions)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-production-google-maps-api-key

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ====================================
# STRIPE PAYMENTS
# ====================================
# Use live public key (pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_your_production_stripe_public_key

# ====================================
# PWA CONFIGURATION
# ====================================
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_PWA_CACHE_STRATEGY=NetworkFirst

# ====================================
# FEATURE FLAGS
# ====================================
NEXT_PUBLIC_FEATURE_CHAT=true
NEXT_PUBLIC_FEATURE_MARKETPLACE=true
NEXT_PUBLIC_FEATURE_ANALYTICS=true
NEXT_PUBLIC_FEATURE_PWA=true

# ====================================
# SENTRY (Error Tracking)
# ====================================
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ====================================
# CDN & ASSETS
# ====================================
# Use CDN for static assets in production
NEXT_PUBLIC_CDN_URL=https://cdn.articonnect.lu
NEXT_PUBLIC_IMAGE_DOMAINS=cdn.articonnect.lu,articonnect-prod-uploads.s3.eu-west-1.amazonaws.com

# ====================================
# LOCALE & INTERNATIONALIZATION
# ====================================
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_SUPPORTED_LOCALES=fr,en,de
NEXT_PUBLIC_TIMEZONE=Europe/Luxembourg

# ====================================
# CONTACT & SUPPORT
# ====================================
NEXT_PUBLIC_SUPPORT_EMAIL=support@articonnect.lu
NEXT_PUBLIC_SUPPORT_PHONE=+352123456789

# ====================================
# BUILD & DEPLOYMENT
# ====================================
# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Build optimizations
ANALYZE=false
BUNDLE_ANALYZE=false
