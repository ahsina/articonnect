# ==============================
# DATABASE
# ==============================
DATABASE_URL="postgresql://articonnect:password@localhost:5432/articonnect?schema=public"
MONGO_URL="mongodb://articonnect:password@localhost:27017/articonnect"
REDIS_URL="redis://localhost:6379"

# ==============================
# AUTHENTICATION
# ==============================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"
ENCRYPTION_KEY="32-bytes-hex-key-for-aes-256-encryption-change-this"

# ==============================
# STRIPE (PAYMENT)
# ==============================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ==============================
# GOOGLE MAPS
# ==============================
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ==============================
# EMAIL (SENDGRID)
# ==============================
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="noreply@articonnect.com"
SENDGRID_FROM_NAME="ArtiConnect"

# ==============================
# SMS (TWILIO)
# ==============================
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"

# ==============================
# AWS S3
# ==============================
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_S3_BUCKET="articonnect-uploads"

# ==============================
# FIREBASE (PUSH NOTIFICATIONS)
# ==============================
FIREBASE_PROJECT_ID="articonnect"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@articonnect.iam.gserviceaccount.com"

# ==============================
# SENTRY (MONITORING)
# ==============================
SENTRY_DSN="https://...@sentry.io/..."

# ==============================
# APPLICATION
# ==============================
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# ==============================
# LOGGING
# ==============================
LOG_LEVEL="info"
