# ===================================
# DATABASE CONFIGURATION
# ===================================

# PostgreSQL - Base de données principale
DATABASE_URL="postgresql://articonnect:password@localhost:5432/articonnect"

# Redis - Cache et géolocalisation
REDIS_URL="redis://localhost:6379"

# MongoDB - Chat et messagerie
MONGODB_URL="mongodb://localhost:27017/articonnect"

# ===================================
# JWT & AUTHENTICATION
# ===================================

# JWT Secret (générer avec: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# JWT Refresh Secret (différent du secret principal)
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"

# JWT Expiration
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# ===================================
# STRIPE PAYMENT
# ===================================

# Stripe Keys (test ou production)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Commission de la plateforme (en pourcentage)
PLATFORM_COMMISSION_PERCENT="10"

# ===================================
# AWS S3 STORAGE
# ===================================

AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="articonnect-uploads"

# ===================================
# FRONTEND CONFIGURATION
# ===================================

# URL de l'API backend
NEXT_PUBLIC_API_URL="http://localhost:4000"

# URL du frontend (pour CORS et redirections)
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Socket.io URL (même que API_URL généralement)
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ===================================
# EMAIL (SMTP)
# ===================================

# Configuration SMTP (exemple avec Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@articonnect.com"

# ===================================
# SMS (TWILIO) - Pour 2FA
# ===================================

TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# ===================================
# SECURITY
# ===================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# CORS Origins (séparés par des virgules)
CORS_ORIGINS="http://localhost:3000,https://articonnect.com"

# ===================================
# MONITORING & LOGGING
# ===================================

# Sentry (Error tracking)
SENTRY_DSN="your-sentry-dsn"
SENTRY_ENVIRONMENT="development"

# Datadog (APM et logs - optionnel)
DATADOG_API_KEY="your-datadog-api-key"
DATADOG_APP_KEY="your-datadog-app-key"

# Log Level
LOG_LEVEL="debug"

# ===================================
# ENVIRONMENT
# ===================================

NODE_ENV="development"
PORT="4000"
FRONTEND_PORT="3000"

# ===================================
# MULTI-COUNTRY
# ===================================

# Pays supportés (ISO codes séparés par virgules)
SUPPORTED_COUNTRIES="LU,FR,BE"

# TVA par pays (JSON format)
VAT_RATES='{"LU":17,"FR":20,"BE":21}'

# ===================================
# FEATURES FLAGS (optionnel)
# ===================================

# Activer/désactiver des fonctionnalités
ENABLE_2FA="true"
ENABLE_MARKETPLACE="true"
ENABLE_CHAT="true"
ENABLE_PUSH_NOTIFICATIONS="true"

# ===================================
# DEVELOPMENT ONLY
# ===================================

# Seed Database avec données de test
SEED_DATABASE="false"

# Debug mode
DEBUG="false"
