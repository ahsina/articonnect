# ===================================
# ArtiConnect - Test Environment
# ===================================
# Copier ce fichier vers .env.test et remplir les valeurs

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/articonnect_test"

# JWT
JWT_SECRET="test-jwt-secret-key-change-in-production-minimum-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe (utiliser les clés de test depuis https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_your_test_key_here"
STRIPE_WEBHOOK_SECRET="whsec_test_your_webhook_secret_here"
STRIPE_COMMISSION_RATE="12" # Pourcentage de commission (12%)

# AWS S3 (utiliser LocalStack pour les tests ou compte AWS de test)
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="articonnect-test"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Email (utiliser Mailhog, MailCatcher ou service de test)
EMAIL_HOST="localhost"
EMAIL_PORT="1025"
EMAIL_USER="test"
EMAIL_PASSWORD="test"
EMAIL_FROM="noreply@articonnect.test"

# Twilio (compte de test depuis https://www.twilio.com/console)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+15005550006" # Numéro de test Twilio
TWILIO_VERIFY_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Application
PORT="3001"
NODE_ENV="test"
API_PREFIX="api"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_TTL="60"
RATE_LIMIT_MAX="100"

# File Upload
MAX_FILE_SIZE="10485760" # 10MB
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"
