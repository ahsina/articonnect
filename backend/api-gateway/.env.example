# ========================================
# ArtiConnect API - Environment Variables
# ========================================

# ========================================
# Application
# ========================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ========================================
# Database (PostgreSQL)
# ========================================
DATABASE_URL=postgresql://articonnect:articonnect_dev_password@localhost:5432/articonnect?schema=public

# ========================================
# Redis
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# MongoDB (if needed)
# ========================================
MONGODB_URI=mongodb://articonnect:articonnect_dev_password@localhost:27017/articonnect?authSource=admin

# ========================================
# JWT Authentication
# ========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# CORS Configuration
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ========================================
# Stripe Payment
# ========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id

# 3D Secure (SCA) Configuration
# 3D Secure is ENABLED by default for all card payments
# Payment intents are configured with:
# - automatic_payment_methods.enabled = true
# - payment_method_options.card.request_three_d_secure = 'any'
# This ensures PSD2 SCA compliance and reduces fraud risk
# No additional configuration needed - handled automatically by Stripe

# Apple Pay & Google Pay Configuration
# Both are ENABLED by default via automatic_payment_methods
# Apple Pay requires domain verification:
#   1. Download verification file from Stripe Dashboard
#   2. Host at: /.well-known/apple-developer-merchantid-domain-association
#   3. Verify domain via Admin API or Stripe Dashboard
# Google Pay works automatically on Chrome/Android devices
# Optional: Set merchant ID for Google Pay branding
STRIPE_MERCHANT_ID=your_merchant_id_for_google_pay

# Stripe Radar - Fraud Detection
# Stripe Radar is ENABLED by default for all Stripe accounts
# It automatically analyzes every payment for fraud using ML
# Configuration:
#   1. Enable/disable in Stripe Dashboard > Settings > Radar
#   2. Configure rules in Stripe Dashboard > Radar > Rules
#   3. Set block/review lists for high-risk transactions
#   4. Monitor reviews in Stripe Dashboard > Radar > Reviews
# Webhooks handled:
#   - review.opened (payment flagged for manual review)
#   - review.closed (review resolved)
#   - radar.early_fraud_warning.created (card issuer fraud alert)
# Frontend: Pass Radar session ID for enhanced fraud detection
# No additional server-side configuration needed

# SEPA Direct Debit - Bank Transfer Payment
# SEPA (Single Euro Payments Area) enables bank-to-bank transfers
# across 36 European countries with low fees
# Configuration:
#   1. Enable in Stripe Dashboard > Settings > Payment methods > SEPA Direct Debit
#   2. Customer provides IBAN and authorizes mandate (SetupIntent)
#   3. Payments take 5-7 business days to complete
#   4. Ideal for recurring payments and European clients
# Webhooks handled:
#   - setup_intent.succeeded (mandate created)
#   - setup_intent.setup_failed (mandate creation failed)
#   - charge.succeeded (payment completed after 5-7 days)
#   - charge.failed (insufficient funds, account closed, etc.)
# Countries supported: All SEPA countries (EU + Switzerland, Norway, etc.)
# No additional configuration needed - managed via Stripe Dashboard

# Deferred Payment - Professional Clients (B2B)
# Allows trusted business clients to pay after service completion
# Payment terms: Net-30, Net-60, or Net-90 days
# Eligibility criteria (automatic):
#   - Reputation score 150+ (excellent payment history)
#   - Minimum 10 completed missions
#   - No disputes in last 6 months
#   - No-show rate < 5%
#   - Dispute rate < 3%
# Admin manual approval required to activate
# CRON jobs:
#   - Daily (09:00): Check overdue invoices, send reminders
#   - Quarterly: Credit review and limit adjustment
# Features:
#   - Credit limits (configurable per client)
#   - Automatic suspension after 3 overdue invoices
#   - Payment reminders (7, 14, 30 days overdue)
#   - Real-time outstanding balance tracking
# No additional configuration needed - managed via admin dashboard

# ========================================
# AWS S3 (File Storage)
# ========================================
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=articonnect-uploads

# ========================================
# ClamAV Antivirus - File Upload Protection
# ========================================
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT=60000
CLAMAV_QUARANTINE_PATH=/var/quarantine/articonnect

# ClamAV Features:
# - Real-time virus scanning for all uploaded files
# - Scans BEFORE files are uploaded to S3 (zero-day protection)
# - Automatic quarantine of infected files
# - Supports all file types (images, documents, PDFs, etc.)
# - Scan result logging and statistics
# - Configurable scan timeout (60 seconds default)
#
# Security Benefits:
# - Prevents malware from reaching your S3 bucket
# - Blocks ransomware, trojans, and other threats
# - Protects users from downloading infected files
# - Audit trail of all scans and detections
# - Quarantine infected files for security review
#
# Installation (Ubuntu/Debian):
# 1. Install ClamAV daemon:
#    sudo apt-get update
#    sudo apt-get install clamav clamav-daemon
#
# 2. Update virus definitions:
#    sudo freshclam
#
# 3. Start ClamAV daemon:
#    sudo systemctl start clamav-daemon
#    sudo systemctl enable clamav-daemon
#
# 4. Verify ClamAV is running:
#    sudo systemctl status clamav-daemon
#    sudo clamdscan --version
#
# 5. Create quarantine directory:
#    sudo mkdir -p /var/quarantine/articonnect
#    sudo chown www-data:www-data /var/quarantine/articonnect
#    sudo chmod 700 /var/quarantine/articonnect
#
# Docker Setup:
# If running in Docker, add ClamAV service to docker-compose.yml:
#   clamav:
#     image: clamav/clamav:latest
#     ports:
#       - "3310:3310"
#     volumes:
#       - ./clamav:/var/lib/clamav
#
# Then update CLAMAV_HOST to point to the Docker service:
#   CLAMAV_HOST=clamav
#
# Performance Notes:
# - First scan after startup may take 5-10 seconds (database loading)
# - Subsequent scans are very fast (<1 second for most files)
# - Large files (>10MB) may take longer to scan
# - Consider increasing CLAMAV_SCAN_TIMEOUT for large files
#
# Production Recommendations:
# 1. Set up automatic virus definition updates (freshclam)
# 2. Monitor quarantine directory for threats
# 3. Set up alerts for infected file uploads
# 4. Regularly review scan statistics
# 5. Configure backup for quarantine directory
#
# Fallback Behavior:
# - If ClamAV is disabled or unavailable, uploads will proceed WITHOUT scanning
# - This ensures service availability even if antivirus is down
# - Set CLAMAV_ENABLED=true in production for security
#
# Testing:
# To test malware detection, download EICAR test file:
# wget https://secure.eicar.org/eicar.com.txt
# Upload via API - should be blocked and quarantined

# ========================================
# Firebase Cloud Messaging (Notifications)
# ========================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour Firebase Private Key\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ========================================
# Twilio SMS - Production Configuration
# ========================================
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+33600000000

# Twilio Features:
# - Phone verification (2FA codes)
# - Mission notifications (accepted, arrived, completed)
# - Payment confirmations
# - Dispute alerts
# - Emergency notifications
#
# SMS Templates (9 pre-configured):
# - verification_code: 2FA codes (10 min expiry)
# - mission_accepted: Artisan accepted with ETA
# - artisan_arrived: Arrival notification
# - mission_completed: Completion with review link
# - payment_received: Payment confirmation
# - new_mission_nearby: Mission alerts for artisans
# - password_reset: Password reset link (1 hour expiry)
# - dispute_opened: Dispute notification
# - payment_reminder: Overdue invoice reminder
#
# Rate Limits (anti-spam):
# - 10 SMS per hour per user
# - 50 SMS per day per user
#
# Features:
# - Opt-out management (STOP/START commands)
# - International phone support (auto +33 for French numbers)
# - Delivery status tracking via webhooks
# - Cost monitoring
# - 7-day SMS history in Redis
#
# Webhook Configuration:
# Set in Twilio Console > Phone Numbers > Configure:
# Status Callback URL: https://yourdomain.com/webhooks/twilio/status
# HTTP Method: POST
#
# Production Setup:
# 1. Buy Twilio phone number (France: +33 recommended)
# 2. Verify phone number in Twilio Console
# 3. Set webhook URL for delivery status
# 4. Test with sandbox number first
# 5. Enable production mode
#
# Cost Estimation (France):
# - Outbound SMS: ~€0.07 per message
# - Inbound SMS: Free
# - Monitor costs via Twilio Console
#
# API Base URL for webhooks
API_BASE_URL=https://yourdomain.com

# ========================================
# OAuth Providers
# ========================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:4000/auth/facebook/callback

# Apple OAuth (Sign in with Apple)
APPLE_CLIENT_ID=com.articonnect.service
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Apple Private Key\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL=http://localhost:4000/auth/apple/callback

# ========================================
# Google Maps API (Geocoding)
# ========================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ========================================
# Email Service (SendGrid / Mailgun / etc.)
# ========================================
# Option 1: SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@articonnect.fr
SENDGRID_FROM_NAME=ArtiConnect

# Option 2: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@articonnect.fr

# ========================================
# Google reCAPTCHA v3
# ========================================
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_ENABLED=true

# ========================================
# Security & Rate Limiting
# ========================================
# Throttling is configured in app.module.ts
# Default: 10/sec, 100/min, 1000/hour

# ========================================
# Monitoring & Logging
# ========================================
# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# DataDog (APM & Logging)
# DD_API_KEY=your_datadog_api_key
# DD_SERVICE=articonnect-api
# DD_ENV=development

# ========================================
# Feature Flags
# ========================================
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PHONE_VERIFICATION=true
ENABLE_MARKETPLACE=true

# ========================================
# Development Tools
# ========================================
# Prisma Studio (accessible at http://localhost:5555)
# No configuration needed, uses DATABASE_URL
