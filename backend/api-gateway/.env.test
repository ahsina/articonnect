# ArtiConnect - Test Environment
# Généré automatiquement pour les tests E2E

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/articonnect_test"

# JWT
JWT_SECRET="test-jwt-secret-key-for-e2e-testing-minimum-32-characters-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe (clés de test - peuvent être mockées)
STRIPE_SECRET_KEY="sk_test_51MockTestKey123456789"
STRIPE_WEBHOOK_SECRET="whsec_test_mock_webhook_secret"
STRIPE_COMMISSION_RATE="12"

# AWS S3 (mock pour tests)
AWS_ACCESS_KEY_ID="test-access-key"
AWS_SECRET_ACCESS_KEY="test-secret-key"
AWS_REGION="eu-west-1"
AWS_S3_BUCKET="articonnect-test"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Email (mock)
EMAIL_HOST="localhost"
EMAIL_PORT="1025"
EMAIL_USER="test"
EMAIL_PASSWORD="test"
EMAIL_FROM="noreply@articonnect.test"

# Twilio (mock)
TWILIO_ACCOUNT_SID="ACtest1234567890123456789012345678"
TWILIO_AUTH_TOKEN="test_auth_token"
TWILIO_PHONE_NUMBER="+15005550006"
TWILIO_VERIFY_SID="VAtest1234567890123456789012345678"

# Application
PORT="3001"
NODE_ENV="test"
API_PREFIX="api"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_TTL="60"
RATE_LIMIT_MAX="1000"

# File Upload
MAX_FILE_SIZE="10485760"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"
