// Krafolt - Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// USERS & AUTHENTICATION
// ================================

enum UserRole {
  CLIENT
  ARTISAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  phone    String?    @unique
  password String
  role     UserRole   @default(CLIENT)
  status   UserStatus @default(ACTIVE)

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // Encrypted

  // Profil
  firstName String
  lastName  String
  avatar    String? // URL S3
  fcmTokens String[] @default([]) // Firebase Cloud Messaging tokens for push notifications

  // Outlook Calendar Integration
  outlookAccessToken  String? // OAuth access token for Microsoft Graph API
  outlookRefreshToken String? // OAuth refresh token
  outlookTokenExpiry  DateTime? // Token expiration timestamp

  // Locale/i18n
  preferredLocale String @default("fr") // fr, en, de, es, it, nl, pt, ar, tr, pl, ro, be, ch

  // Metadata
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  phoneVerified   Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Reputation & Payment Trust System
  reputationScore   Int     @default(100) // Score 0-200 (100 = neutral)
  completedMissions Int     @default(0)
  noShowCount       Int     @default(0)
  disputeCount      Int     @default(0)
  disputeRate       Decimal @default(0) @db.Decimal(5, 2) // Percentage

  // Relations
  clientProfile    ClientProfile?
  artisanProfile   ArtisanProfile?
  refreshTokens    RefreshToken[]
  backupCodes      BackupCode[]
  consents         UserConsent?
  notifications    Notification[]
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")

  // Missions
  clientMissions  Mission[] @relation("ClientMissions")
  artisanMissions Mission[] @relation("ArtisanMissions")

  // Reviews
  givenReviews    Review[]         @relation("GivenReviews")
  receivedReviews Review[]         @relation("ReceivedReviews")
  reviewResponses ReviewResponse[] @relation("ReviewResponses")

  // Disputes
  disputesCreated  Dispute[] @relation("DisputesCreated")
  disputesResolved Dispute[] @relation("DisputesResolved")

  // Marketplace
  products Product[]
  orders   Order[]
  returns  OrderReturn[] @relation("ClientReturns")

  // Saved by clients
  savedByClients SavedArtisan[]

  // Payment & Reputation System
  noShowEvents      NoShowEvent[]
  reputationHistory ReputationHistory[]
  compensationLogs  CompensationLog[]
  payments          Payment[]

  // Favorites & Requests
  favorites        Favorite[]
  favoriteArtisans Favorite[] @relation("FavoriteArtisans")
  clientRequests   Request[]  @relation("ClientRequests")
  artisanRequests  Request[]  @relation("ArtisanRequests")

  // Invoices
  issuedInvoices   Invoice[] @relation("IssuedInvoices")
  receivedInvoices Invoice[] @relation("ReceivedInvoices")

  // Negotiations
  negotiationsSent     Negotiation[] @relation("NegotiationsSent")
  negotiationsReceived Negotiation[] @relation("NegotiationsReceived")

  // Mission History
  missionHistoryChanges MissionHistory[] @relation("MissionHistoryChanges")

  // Employee Shifts
  shiftsCreated EmployeeShift[] @relation("ShiftsCreated")
  shiftsUpdated EmployeeShift[] @relation("ShiftsUpdated")

  // VAT declarations
  vatDeclarations VatDeclaration[]

  // Reports
  reportsMade     Report[] @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")
  reportsResolved Report[] @relation("ReportsResolved")

  // Content Moderation
  contentViolations ContentViolation[] @relation("ContentViolations")

  // Fraud Detection & Security
  // Multi-Account Detection
  deviceFingerprints     String[]  @default([]) // Array of device fingerprint IDs
  lastUserAgent          String?
  lastIpAddress          String?
  multiAccountRiskScore  Int       @default(0) // 0-100
  multiAccountFlagged    Boolean   @default(false)
  multiAccountReviewedAt DateTime?

  // KYC/AML Compliance
  kycVerified   Boolean   @default(false)
  kycVerifiedAt DateTime?
  kycStatus     String    @default("PENDING") // PENDING, VERIFIED, REJECTED, REQUIRED
  kycProvider   String? // STRIPE_IDENTITY, ONFIDO, etc.
  kycSessionId  String?
  stripeIdentitySessionId String? // Current Stripe Identity verification session

  // Refund Abuse Tracking
  refundCount      Int     @default(0)
  refundRate       Decimal @default(0) @db.Decimal(5, 2) // Percentage
  refundAbuseScore Int     @default(0) // 0-100
  refundBlocked    Boolean @default(false)

  // Session Security
  lastSessionId       String?
  lastSessionLocation String? // "lat,lng"
  sessionAnomalyCount Int     @default(0)

  // Bot Detection
  botDetectionScore Int     @default(0) // 0-100
  botFlagged        Boolean @default(false)
  captchaRequired   Boolean @default(false)

  // Badges
  badges UserBadge[]

  // Company & Employee Relationships
  ownedCompany Company?          @relation("CompanyOwner")
  employments  CompanyEmployee[] @relation("CompanyEmployees")

  // Quote Builder
  artisanQuotes      Quote[]              @relation("ArtisanQuotes")
  clientQuotes       Quote[]              @relation("ClientQuotes")
  quoteTemplates     QuoteTemplate[]      @relation("ArtisanQuoteTemplates")
  materialCatalog    MaterialCatalogItem[] @relation("ArtisanMaterialCatalog")
  quoteSignatures    QuoteSignature[]     // Electronic signatures made by user

  // Portfolio
  portfolio          Portfolio?           @relation("ArtisanPortfolio")

  // Client CRM
  artisanClientRelationships ClientRelationship[] @relation("ArtisanClientRelationships")
  clientRelationships        ClientRelationship[] @relation("ClientRelationships")

  // Recurring Services
  artisanRecurringServices RecurringService[] @relation("ArtisanRecurringServices")
  clientRecurringServices  RecurringService[] @relation("ClientRecurringServices")

  // Subcontractor Management
  subcontractors     Subcontractor[]      @relation("ArtisanSubcontractors")
  subcontractorOf    Subcontractor[]      @relation("SubcontractorOf")

  // Analytics
  analyticsSnapshots AnalyticsSnapshot[]  @relation("ArtisanAnalytics")
  revenueGoals       RevenueGoal[]        @relation("ArtisanRevenueGoals")

  // Support Tickets
  supportTickets     SupportTicket[]      @relation("UserTickets")
  assignedTickets    SupportTicket[]      @relation("AssignedTickets")
  ticketMessages     TicketMessage[]      @relation("TicketMessagesSent")
  knowledgeBaseArticles KnowledgeBaseArticle[] @relation("KnowledgeBaseAuthor")

  // Document Templates
  documentTemplates  DocumentTemplate[]   @relation("ArtisanDocumentTemplates")

  // Country Compliance
  complianceRecords  ArtisanComplianceRecord[] @relation("ArtisanCompliance")

  // Internal Chat
  chatMemberships    ChatMember[]
  chatMessages       ChatMessage[]
  chatReadReceipts   ChatReadReceipt[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([reputationScore])
  @@index([multiAccountRiskScore])
  @@index([kycStatus])
}

model ClientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Client Type (B2C vs B2B)
  clientType  String  @default("INDIVIDUAL") // INDIVIDUAL, PROFESSIONAL
  companyName String? // For professional clients
  siret       String? // SIRET/Business registration number
  vatNumber   String? // VAT/TVA number
  industry    String? // Industry/sector

  // Addresses
  addresses Address[]

  // Payment
  stripeCustomerId     String? @unique
  defaultPaymentMethod String?

  // Deferred Payment (Professional Clients)
  deferredPaymentEnabled Boolean   @default(false) // Pro client with payment terms
  paymentTermDays        Int       @default(30) // Net-30, Net-60, etc.
  creditLimit            Decimal   @default(0) @db.Decimal(10, 2) // Maximum outstanding amount
  currentOutstanding     Decimal   @default(0) @db.Decimal(10, 2) // Current unpaid invoices
  lastCreditReview       DateTime? // Last time credit was reviewed
  deferredPaymentNotes   String? // Internal notes about payment terms

  // Favoris
  savedArtisans SavedArtisan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientType])
  @@index([siret])
}

model ArtisanProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Company Association (optional - for solo artisans converted to company employees)
  companyId String?
  company   Company? @relation("CompanyArtisans", fields: [companyId], references: [id], onDelete: SetNull)

  // Business info
  companyName String
  siret       String  @unique
  vatNumber   String? // Encrypted
  description String?
  website     String?

  // Specialties
  specialties Specialty[]

  // Service area
  serviceRadius Int    @default(20) // km
  baseAddress   String
  latitude      Float
  longitude     Float

  // Pricing
  hourlyRate    Decimal? @db.Decimal(10, 2)
  emergencyRate Decimal? @db.Decimal(10, 2)

  // Documents
  insurance      String? // URL
  certifications Certification[]

  // Stripe Connect
  stripeAccountId String? @unique
  stripeOnboarded Boolean @default(false)

  // Business Verification (Multi-country: FR/LU/BE)
  businessVerified              Boolean   @default(false)
  businessVerifiedAt            DateTime?
  businessVerificationStatus    String    @default("PENDING") // PENDING, VERIFIED, REJECTED, MANUAL_REVIEW
  businessRegistrationNumber    String? // SIRET (FR), RCS (LU), KBO (BE)
  businessCountry               String? // FR, LU, BE
  businessVerificationErrors    String[]  @default([])
  businessVerificationWarnings  String[]  @default([])
  businessLegalForm             String? // SARL, SPRL, S.à r.l., etc.
  businessActivityCode          String? // NAF (FR), NACE (BE/LU)
  businessVerificationLastCheck DateTime?

  // Stats
  rating       Decimal @default(0) @db.Decimal(3, 2)
  reviewCount  Int     @default(0)
  missionCount Int     @default(0)

  // Availability
  available          Boolean   @default(true)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?

  // Calendar & Availability
  workingHours            WorkingHours[]
  availabilitySlots       AvailabilitySlot[]
  timeOffs                TimeOff[]
  recurringUnavailability RecurringUnavailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([rating])
}

model Address {
  id         String        @id @default(uuid())
  clientId   String
  client     ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label      String // "Home", "Work"
  street     String
  city       String
  postalCode String
  country    String // "LU", "FR", "BE"
  latitude   Float
  longitude  Float
  isDefault  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([clientId])
  @@index([latitude, longitude])
}

model Specialty {
  id                String           @id @default(uuid())
  name              String           @unique
  category          String
  description       String?
  icon              String?
  artisans          ArtisanProfile[]
  createdAt         DateTime         @default(now())
  CompanyEmployee   CompanyEmployee? @relation(fields: [companyEmployeeId], references: [id])
  companyEmployeeId String?
}

model Certification {
  id         String         @id @default(uuid())
  artisanId  String
  artisan    ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  name       String
  issuer     String
  issueDate  DateTime
  expiryDate DateTime?
  document   String?
  verified   Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

// ================================
// COMPANIES & EMPLOYEES
// ================================

enum EmployeeRole {
  OWNER // Full access, company owner
  MANAGER // Can manage employees and assign missions
  SUPERVISOR // Can assign missions, view reports
  TECHNICIAN // Performs missions, limited access
  CONTRACTOR // External contractor, temporary access
}

enum EmployeeStatus {
  ACTIVE // Currently employed
  INACTIVE // Temporarily inactive
  TERMINATED // Employment ended
  PENDING_INVITATION // Invitation sent, not accepted
}

enum PaymentModel {
  SALARY // Fixed salary, no mission commissions
  COMMISSION // Commission-based on missions
  HYBRID // Base salary + commission on missions
}

model Company {
  id String @id @default(uuid())

  // Business Information
  companyName String
  siret       String  @unique
  vatNumber   String?
  description String?
  website     String?
  logo        String? // S3 URL

  // Owner (original artisan who created the company)
  ownerId String @unique
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Location & Service Area
  baseAddress   String
  city          String
  postalCode    String
  country       String // FR, LU, BE
  latitude      Float
  longitude     Float
  serviceRadius Int    @default(20)

  // Business Verification
  businessVerified              Boolean   @default(false)
  businessVerifiedAt            DateTime?
  businessVerificationStatus    String    @default("PENDING")
  businessRegistrationNumber    String?
  businessCountry               String?
  businessVerificationErrors    String[]  @default([])
  businessVerificationWarnings  String[]  @default([])
  businessLegalForm             String?
  businessActivityCode          String?
  businessVerificationLastCheck DateTime?

  // Stripe Connect (company-level account)
  stripeAccountId String? @unique
  stripeOnboarded Boolean @default(false)

  // Company Stats (aggregated from all employees)
  totalMissions Int     @default(0)
  totalRevenue  Decimal @default(0) @db.Decimal(12, 2)
  averageRating Decimal @default(0) @db.Decimal(3, 2)
  totalReviews  Int     @default(0)

  // Relationships
  employees       CompanyEmployee[]
  artisanProfiles ArtisanProfile[]  @relation("CompanyArtisans")
  missions        Mission[]
  settings        CompanySettings?
  chatRooms       ChatRoom[]
  timeEntries     TimeEntry[]

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@index([siret])
  @@index([ownerId])
  @@index([latitude, longitude])
  @@index([averageRating])
}

model CompanyEmployee {
  id String @id @default(uuid())

  // Company & User Relationship
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("CompanyEmployees", fields: [userId], references: [id], onDelete: Cascade)

  // Employment Details
  role                 EmployeeRole   @default(TECHNICIAN)
  status               EmployeeStatus @default(PENDING_INVITATION)
  invitationToken      String?        @unique
  invitationSentAt     DateTime?
  invitationAcceptedAt DateTime?

  // Employment Dates
  startDate DateTime  @default(now())
  endDate   DateTime?

  // Payment Configuration
  paymentModel   PaymentModel @default(COMMISSION)
  baseSalary     Decimal?     @db.Decimal(10, 2) // Monthly base salary (if SALARY or HYBRID)
  commissionRate Decimal?     @db.Decimal(5, 2) // Percentage of mission revenue (0-100)
  hourlyRate     Decimal?     @db.Decimal(10, 2) // Hourly rate for time tracking

  // Permissions (JSON array of permission strings)
  permissions Json @default("[]") // ["canViewAllMissions", "canAssignMissions", etc.]

  // Skills & Specialties
  specialties Specialty[]

  // Performance Stats
  totalMissions Int     @default(0)
  totalEarnings Decimal @default(0) @db.Decimal(12, 2)
  averageRating Decimal @default(0) @db.Decimal(3, 2)
  totalReviews  Int     @default(0)

  // Assigned Missions
  assignedMissions  Mission[] @relation("EmployeeAssignedMissions")
  completedMissions Mission[] @relation("EmployeeCompletedMissions")

  // Earnings History
  earnings EmployeeEarnings[]

  // Scheduling & Time Tracking
  shifts       EmployeeShift[]
  timeTracking MissionTimeTracking[]
  timeEntries  TimeEntry[]

  // Performance Reviews
  reviewsReceived  PerformanceReview[] @relation("EmployeeReviews")
  reviewsConducted PerformanceReview[] @relation("ConductedReviews")

  // Skills & Certifications
  skills EmployeeSkill[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId]) // One user can only be employed once per company
  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([role])
}

model EmployeeEarnings {
  id String @id @default(uuid())

  // Employee & Mission
  employeeId String
  employee   CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  missionId  String
  mission    Mission         @relation(fields: [missionId], references: [id], onDelete: Restrict)

  // Earnings Breakdown
  missionRevenue         Decimal @db.Decimal(10, 2) // Total mission price
  platformCommission     Decimal @db.Decimal(10, 2) // 12% platform fee
  companyRevenue         Decimal @db.Decimal(10, 2) // After platform fee
  employeeCommission     Decimal @db.Decimal(10, 2) // Employee's share
  employeeCommissionRate Decimal @db.Decimal(5, 2) // Percentage used

  // Payout Status
  status       String    @default("PENDING") // PENDING, PROCESSING, PAID, FAILED
  payoutDate   DateTime?
  payoutMethod String?   @default("STRIPE_TRANSFER") // STRIPE_TRANSFER, BANK_TRANSFER, MANUAL

  // Stripe Reference
  stripeTransferId String? @unique

  // Notes
  notes String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([missionId])
  @@index([status])
  @@index([payoutDate])
  // Additional composite index for earnings queries
  @@index([employeeId, status, createdAt])
}

model CompanySettings {
  id String @id @default(uuid())

  // Company Reference
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Commission Settings
  defaultCommissionRate Decimal @default(50) @db.Decimal(5, 2) // Default employee commission % (0-100)
  ownerCommissionRate   Decimal @default(100) @db.Decimal(5, 2) // Owner gets 100% by default

  // Mission Assignment
  autoAssignMissions          Boolean @default(false) // Auto-assign based on availability & skills
  requireManagerApproval      Boolean @default(false) // Manager must approve mission acceptance
  allowEmployeeSelfAssignment Boolean @default(true) // Employees can claim unassigned missions

  // Payment Settings
  payoutFrequency String  @default("WEEKLY") // DAILY, WEEKLY, BIWEEKLY, MONTHLY
  minimumPayout   Decimal @default(50) @db.Decimal(10, 2) // Minimum amount to trigger payout

  // Notification Settings
  notifyOwnerOnNewMission    Boolean @default(true)
  notifyManagerOnNewMission  Boolean @default(true)
  notifyEmployeeOnAssignment Boolean @default(true)

  // Working Hours (company-wide defaults)
  defaultWorkingHoursStart String? // "09:00"
  defaultWorkingHoursEnd   String? // "18:00"

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeShift {
  id String @id @default(uuid())

  // Employee Reference
  employeeId String
  employee   CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Shift Details
  startTime DateTime
  endTime   DateTime
  shiftType String   @default("REGULAR") // REGULAR, OVERTIME, ONCALL, BREAK
  status    String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED

  // Notes & Metadata
  notes       String?
  createdById String
  createdBy   User    @relation("ShiftsCreated", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ShiftsUpdated", fields: [updatedById], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([startTime])
  @@index([endTime])
  @@index([status])
  @@index([createdById])
}

model MissionTimeTracking {
  id String @id @default(uuid())

  // Mission & Employee
  missionId  String
  mission    Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  employeeId String
  employee   CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Time Tracking
  startTime  DateTime
  endTime    DateTime?
  totalHours Decimal?  @db.Decimal(8, 2)
  breakTime  Decimal?  @default(0) @db.Decimal(8, 2) // Hours
  billable   Boolean   @default(true)

  // Location Tracking (optional)
  startLocation String? // Lat,Long or address
  endLocation   String? // Lat,Long or address

  // Notes
  notes String?

  // Status
  status String @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, PAUSED

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([missionId])
  @@index([employeeId])
  @@index([status])
}

// ================================
// TIME TRACKING (Pointeuse)
// ================================

enum TimeEntryType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum TimeEntryStatus {
  ACTIVE
  COMPLETED
  INVALID
}

model TimeEntry {
  id String @id @default(uuid())

  // Employee & Company
  employeeId String
  employee   CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Entry Details
  type      TimeEntryType
  timestamp DateTime
  location  Json?          // { lat: number, lng: number }
  notes     String?
  missionId String?        // Optional: link to specific mission

  // Status & Validation
  status    TimeEntryStatus @default(ACTIVE)
  corrected Boolean         @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Corrections
  corrections TimeEntryCorrection[]

  @@index([employeeId])
  @@index([companyId])
  @@index([timestamp])
  @@index([type])
  @@index([status])
}

model TimeEntryCorrection {
  id String @id @default(uuid())

  // Time Entry Reference
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  // Correction Details
  correctedBy       String   // User ID who made correction
  originalTimestamp DateTime
  newTimestamp      DateTime
  reason            String

  // Timestamps
  createdAt DateTime @default(now())

  @@index([timeEntryId])
  @@index([correctedBy])
}

model PerformanceReview {
  id String @id @default(uuid())

  // Employee & Reviewer
  employeeId String
  employee   CompanyEmployee @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   CompanyEmployee @relation("ConductedReviews", fields: [reviewerId], references: [id], onDelete: Restrict)

  // Review Period
  reviewPeriodStart DateTime
  reviewPeriodEnd   DateTime

  // Ratings (1-5 scale)
  qualityOfWork      Int? // 1-5
  communication      Int? // 1-5
  reliability        Int? // 1-5
  technicalSkills    Int? // 1-5
  customerService    Int? // 1-5
  teamwork           Int? // 1-5
  overallRating      Decimal? @db.Decimal(3, 2) // Average or custom overall

  // Feedback
  strengths          String?
  areasForImprovement String?
  goals              String?
  notes              String?

  // Status
  status String @default("DRAFT") // DRAFT, SUBMITTED, ACKNOWLEDGED

  // Acknowledgement
  acknowledgedAt DateTime?
  acknowledgedBy String? // Employee acknowledges review

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewerId])
  @@index([reviewPeriodStart])
  @@index([status])
}

model EmployeeSkill {
  id String @id @default(uuid())

  // Employee Reference
  employeeId String
  employee   CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Skill Details
  skillName        String
  skillCategory    String? // e.g., "Plumbing", "Electrical", "Carpentry"
  proficiencyLevel String  @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT

  // Certification
  certified        Boolean @default(false)
  certificationName String?
  certificationNumber String?
  certifiedBy      String? // Certifying body/organization
  certificationDate DateTime?
  expirationDate   DateTime?

  // Verification
  verified   Boolean @default(false)
  verifiedBy String? // User ID who verified
  verifiedAt DateTime?

  // Document Reference
  documentUrl String? // Link to certificate/credential

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, skillName])
  @@index([employeeId])
  @@index([skillCategory])
  @@index([certified])
}

model SavedArtisan {
  id        String        @id @default(uuid())
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisanId String
  artisan   User          @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([clientId, artisanId])
}

// ================================
// MISSIONS
// ================================

enum MissionType {
  EMERGENCY // Urgent
  SCHEDULED // Planned
  QUOTE // Quote request
}

enum MissionStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  PENDING_DEPOSIT // NEW: Waiting for deposit payment
  DEPOSIT_PAID // NEW: Deposit paid, ready for artisan travel
  IN_TRANSIT // NEW: Artisan traveling to client
  PAID
  IN_PROGRESS
  COMPLETED
  AUTO_VALIDATED // NEW: Auto-validated after 7 days timeout
  CANCELLED
  CANCELLED_NO_SHOW // NEW: Cancelled because client was unavailable
  DISPUTED
}

model Mission {
  id       String @id @default(uuid())
  clientId String
  client   User   @relation("ClientMissions", fields: [clientId], references: [id])

  // Solo Artisan Assignment (legacy/backward compatibility)
  artisanId String?
  artisan   User?   @relation("ArtisanMissions", fields: [artisanId], references: [id])

  // Company Assignment (new multi-employee support)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Employee Assignment (who actually performs the work)
  assignedToId  String?
  assignedTo    CompanyEmployee? @relation("EmployeeAssignedMissions", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   CompanyEmployee? @relation("EmployeeCompletedMissions", fields: [completedById], references: [id], onDelete: SetNull)

  type        MissionType
  status      MissionStatus @default(PENDING)
  title       String
  description String
  category    String

  // Location
  address    String
  city       String
  postalCode String
  country    String
  latitude   Float
  longitude  Float

  // Scheduling
  scheduledFor      DateTime?
  estimatedDuration Int? // minutes

  // Pricing
  clientBudget Decimal? @db.Decimal(10, 2)
  artisanQuote Decimal? @db.Decimal(10, 2)
  agreedPrice  Decimal? @db.Decimal(10, 2)
  finalPrice   Decimal? @db.Decimal(10, 2)
  vatRate      Decimal  @db.Decimal(5, 2)
  totalAmount  Decimal? @db.Decimal(10, 2)

  // Hybrid Payment System (Reputation-based)
  depositRequired     Boolean   @default(false)
  depositPercentage   Int       @default(30) // 30%, 50%, or 100%
  depositAmount       Decimal?  @db.Decimal(10, 2)
  depositPaidAt       DateTime?
  retractionExpiresAt DateTime? // 48h after completion
  autoValidated       Boolean   @default(false) // True if auto-validated after 7 days

  // Price Anomaly Detection
  priceAnomalyFlag    Boolean   @default(false) // Flagged as suspicious pricing
  expectedPrice       Decimal?  @db.Decimal(10, 2) // ML-predicted fair price
  priceDeviation      Int? // Percentage deviation from norm (-100 to +100)
  priceAnomalySignals String[]  @default([]) // Array of anomaly signals
  priceReviewedAt     DateTime? // When price was reviewed
  priceReviewedBy     String? // Admin who reviewed

  // Media - Before/After Photos
  photos       String[] // Legacy field for backward compatibility
  beforePhotos String[] // Photos taken before the work (by client)
  afterPhotos  String[] // Photos taken after the work (by artisan)

  // B2B Billing (for professional clients)
  purchaseOrderNumber String? // Numéro de bon de commande
  internalReference   String? // Référence interne client
  billingCompanyName  String? // Nom entreprise facturation (si différent)
  billingAddress      String? // Adresse de facturation (si différente)
  billingVatNumber    String? // Numéro TVA facturation

  // Radius Expansion (automatic search expansion when no artisan responds)
  initialSearchRadius Int       @default(20) // Initial search radius in km
  currentSearchRadius Int       @default(20) // Current search radius in km
  lastRadiusExpansion DateTime? // When radius was last expanded
  maxRadiusReached    Boolean   @default(false) // True if max radius (100km) reached
  notificationsSent   Int       @default(0) // Track number of artisans notified

  // Relations
  negotiations      Negotiation[]
  transaction       Transaction?
  payments          Payment[]
  reviews           Review[]
  disputes          Dispute[]
  history           MissionHistory[]
  noShowEvent       NoShowEvent?
  invoices          Invoice[]
  reports           Report[]
  availabilitySlots AvailabilitySlot[]
  employeeEarnings  EmployeeEarnings[]
  timeTracking      MissionTimeTracking[]

  // New Feature Relations
  quotes               Quote[]                   @relation("MissionQuotes")
  portfolioProjects    PortfolioProject[]        @relation("PortfolioMissions")
  recurringMission     RecurringServiceMission?  @relation("RecurringMissions")
  subcontractorAssignments SubcontractorAssignment[] @relation("SubcontractorMissions")
  supportTickets       SupportTicket[]           @relation("TicketMissions")
  jobDocuments         JobDocument[]             @relation("MissionDocuments")
  chatRooms            ChatRoom[]                // Mission-specific chat rooms

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  acceptedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  arrivedAt       DateTime? // NEW: When artisan arrived at client location
  validatedAt     DateTime? // NEW: When client validated work (or 48h passed)
  autoValidatedAt DateTime? // NEW: When system auto-validated (7-day timeout)
  deletedAt       DateTime? // Soft delete

  @@index([clientId])
  @@index([artisanId])
  @@index([companyId])
  @@index([assignedToId])
  @@index([completedById])
  @@index([status])
  @@index([type])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@index([completedAt])
  // Additional composite indexes for performance
  @@index([clientId, status])
  @@index([companyId, status, completedAt])
}

model MissionHistory {
  id            String        @id @default(uuid())
  missionId     String
  mission       Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  status        MissionStatus
  changedById   String?       // Nullable for system-level changes
  changedBy     User?         @relation("MissionHistoryChanges", fields: [changedById], references: [id])
  changedByRole String        // ARTISAN, CLIENT, ADMIN, or SYSTEM
  note          String?       // Optional note about the change
  createdAt     DateTime      @default(now())

  @@index([missionId])
  @@index([changedById])
  @@index([createdAt])
}

model Negotiation {
  id            String  @id @default(uuid())
  missionId     String
  mission       Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User    @relation("NegotiationsSent", fields: [senderId], references: [id])
  receiverId    String
  receiver      User    @relation("NegotiationsReceived", fields: [receiverId], references: [id])
  proposedPrice Decimal @db.Decimal(10, 2)

  // Price breakdown (optional detailed pricing)
  laborCost    Decimal? @db.Decimal(10, 2) // Main d'œuvre
  materialCost Decimal? @db.Decimal(10, 2) // Matériel
  travelCost   Decimal? @db.Decimal(10, 2) // Déplacement

  message        String?
  accepted       Boolean?
  rejectedReason String?
  expiresAt      DateTime? // Timeout for negotiation (24h standard, 15min emergency)
  createdAt      DateTime  @default(now())

  @@index([missionId])
  @@index([expiresAt])
}

// ================================
// REVIEWS
// ================================

enum ReviewType {
  CLIENT_TO_ARTISAN // Client evaluates artisan's work
  ARTISAN_TO_CLIENT // Artisan evaluates client's behavior
}

model Review {
  id         String  @id @default(uuid())
  missionId  String
  mission    Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User    @relation("GivenReviews", fields: [reviewerId], references: [id])
  reviewedId String
  reviewed   User    @relation("ReceivedReviews", fields: [reviewedId], references: [id])

  // Review type (bidirectional reviews)
  reviewType ReviewType @default(CLIENT_TO_ARTISAN)

  // Common ratings (1-5 stars)
  overallRating       Int
  qualityRating       Int? // Work quality (artisan) / Request clarity (client)
  punctualityRating   Int? // On-time arrival (artisan) / Availability (client)
  communicationRating Int? // Communication quality (both)
  valueRating         Int? // Value for money (artisan) / Fair pricing expectations (client)

  // Artisan→Client specific ratings
  paymentPromptness Int? // Client paid on time (1-5)
  respectRating     Int? // Client was respectful and professional (1-5)
  safetyRating      Int? // Work environment was safe (1-5)

  comment        String?
  photos         String[]
  helpful        Int             @default(0)
  verified       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ReviewResponse ReviewResponse?
  reports        Report[]

  // Fraud Detection
  fraudScore      Float     @default(0) // 0-100
  fraudSignals    String[]  @default([]) // Array of detected fraud signals
  aiGenerated     Boolean   @default(false) // AI-generated text detection
  hidden          Boolean   @default(false) // Hidden due to fraud
  hiddenReason    String? // Why the review was hidden
  fraudReviewedAt DateTime? // When fraud review was done
  fraudReviewedBy String? // Admin who reviewed
  deletedAt       DateTime? // Soft delete

  // Unique constraint: one review per mission per type (allows bidirectional reviews)
  @@unique([missionId, reviewType])
  @@index([missionId])
  @@index([reviewedId])
  @@index([fraudScore])
  @@index([hidden])
  @@index([overallRating])
  @@index([reviewType])
}

// Review Responses - Allow artisans to respond to reviews
model ReviewResponse {
  id          String   @id @default(uuid())
  reviewId    String   @unique
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  responderId String
  responder   User     @relation("ReviewResponses", fields: [responderId], references: [id])
  response    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([responderId])
}

// ================================
// DISPUTES
// ================================

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
  CANCELLED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Dispute {
  id           String          @id @default(uuid())
  missionId    String
  mission      Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User            @relation("DisputesCreated", fields: [createdById], references: [id])
  reason       String
  description  String
  status       DisputeStatus   @default(OPEN)
  priority     DisputePriority @default(MEDIUM)
  resolution   String?
  resolvedById String?
  resolvedBy   User?           @relation("DisputesResolved", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([missionId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
}

// ================================
// MARKETPLACE
// ================================

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SOLD_OUT
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  products    Product[]
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@index([active])
}

model Product {
  id          String           @id @default(uuid())
  artisanId   String
  artisan     User             @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  name        String
  description String
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  photos      String[]
  price       Decimal          @db.Decimal(10, 2)
  vatRate     Decimal          @db.Decimal(5, 2)
  stock       Int
  sku         String?          @unique
  status      ProductStatus    @default(DRAFT)
  variants    ProductVariant[]
  orderItems  OrderItem[]
  returnItems ReturnItem[]     @relation("ReturnItems")
  favorites   Favorite[]
  reports     Report[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?        // Soft delete

  @@index([artisanId])
  @@index([status])
  @@index([categoryId])
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2)
  stock           Int
  createdAt       DateTime @default(now())

  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  clientId        String
  client          User          @relation(fields: [clientId], references: [id])
  items           OrderItem[]
  returns         OrderReturn[] @relation("OrderReturns")
  subtotal        Decimal       @db.Decimal(10, 2)
  vat             Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  shippingAddress String
  shippingCost    Decimal       @default(0) @db.Decimal(10, 2)
  trackingNumber  String?
  status          OrderStatus   @default(PENDING)
  transaction     Transaction?
  invoices        Invoice[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  @@index([clientId])
  @@index([status])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RETURN_SHIPPED
  RECEIVED
  REFUNDED
  COMPLETED
}

model OrderReturn {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation("OrderReturns", fields: [orderId], references: [id])
  clientId    String
  client      User         @relation("ClientReturns", fields: [clientId], references: [id])
  items       ReturnItem[]
  reason      ReturnReason
  description String?
  status      ReturnStatus @default(REQUESTED)

  // Shipping info
  returnLabel    String? // URL to return shipping label
  trackingNumber String?

  // Refund info
  refundAmount   Decimal @db.Decimal(10, 2)
  refundedAmount Decimal @default(0) @db.Decimal(10, 2)

  // Evidence
  photos String[] @default([])

  // Admin handling
  reviewedBy String?
  reviewedAt DateTime?
  resolution String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvedAt  DateTime?
  completedAt DateTime?

  @@index([orderId])
  @@index([clientId])
  @@index([status])
}

model ReturnItem {
  id          String      @id @default(uuid())
  returnId    String
  return      OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  productId   String
  product     Product     @relation("ReturnItems", fields: [productId], references: [id])
  quantity    Int
  reason      String?

  @@index([returnId])
}

// ================================
// PAYMENTS
// ================================

enum TransactionType {
  MISSION
  PRODUCT
  REFUND
  DEPOSIT // NEW: Deposit payment (partial)
  COMPENSATION // NEW: Platform compensation to artisan
}

enum TransactionStatus {
  PENDING
  HELD
  COMPLETED
  FAILED
  REFUNDED
}

model Transaction {
  id            String          @id @default(uuid())
  type          TransactionType
  missionId     String?         @unique
  mission       Mission?        @relation(fields: [missionId], references: [id])
  orderId       String?         @unique
  order         Order?          @relation(fields: [orderId], references: [id])
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("EUR")
  commission    Decimal         @db.Decimal(10, 2)
  artisanAmount Decimal         @db.Decimal(10, 2)

  // Stripe payment fields
  stripePaymentIntentId String? @unique
  stripeTransferId      String? @unique

  // PayPal payment fields
  paypalOrderId   String? @unique
  paypalCaptureId String? @unique

  // Payment method tracking
  paymentMethod PaymentMethod @default(STRIPE)

  status      TransactionStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  completedAt DateTime?
  refundedAt  DateTime?

  @@index([status])
  @@index([type])
  @@index([paymentMethod])
}

// ================================
// PAYMENT DETAILS (Hybrid System)
// ================================

enum PaymentType {
  DEPOSIT // Partial payment before travel
  FULL_PAYMENT // Complete payment after work
  REFUND // Money returned to client
  COMPENSATION // Platform pays artisan for client fault
}

enum RefundReason {
  CHANGED_MIND // Client fault → Artisan compensated
  EMERGENCY_RESOLVED // Client fault → Artisan compensated
  WORK_NOT_DONE // Artisan fault → Artisan NOT paid
  WORK_INCOMPLETE // Artisan fault → Partial refund
  MUTUAL_CANCELLATION // Neutral → Compensation if traveling
  ARTISAN_NO_SHOW // Artisan fault → Full refund
  CLIENT_NO_SHOW // Client fault → Artisan compensated
}

enum PaymentMethod {
  STRIPE // Credit/debit card via Stripe
  PAYPAL // PayPal account
  BANK_TRANSFER // Manual bank transfer
  SEPA // SEPA Direct Debit (European bank transfer)
  DEFERRED // B2B deferred payment (Net-30/60/90)
}

model Payment {
  id        String      @id @default(uuid())
  missionId String
  mission   Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId    String // Who made the payment
  user      User        @relation(fields: [userId], references: [id])
  type      PaymentType
  amount    Decimal     @db.Decimal(10, 2)

  // Refund tracking
  refundReason   RefundReason?
  refundedAmount Decimal?      @db.Decimal(10, 2)
  refundedAt     DateTime?

  // Compensation tracking (when platform absorbs cost)
  artisanCompensated   Boolean  @default(false)
  compensationAmount   Decimal? @db.Decimal(10, 2)
  platformAbsorbedCost Boolean  @default(false) // True when we pay both client + artisan

  // Retraction period tracking
  withinRetractionPeriod Boolean   @default(false)
  retractionExpiresAt    DateTime?

  // Payment method tracking
  paymentMethod PaymentMethod @default(STRIPE)

  // Stripe
  stripePaymentIntentId String? @unique
  stripeRefundId        String? @unique

  // PayPal
  paypalOrderId   String? @unique
  paypalCaptureId String? @unique
  paypalRefundId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([missionId])
  @@index([userId])
  @@index([type])
  @@index([paymentMethod])
}

// ================================
// INVOICING
// ================================

enum InvoiceType {
  MISSION // Mission invoice
  MARKETPLACE // Marketplace order invoice
  NO_SHOW_FEE // No-show fee invoice
}

enum InvoiceStatus {
  DRAFT // Being prepared
  ISSUED // Sent to client
  PAID // Payment received
  OVERDUE // Past due date (for deferred payments)
  CANCELLED // Cancelled
  REFUNDED // Refunded
}

model Invoice {
  id String @id @default(uuid())

  // Invoice numbering (e.g. INV-2025-00001)
  invoiceNumber  String @unique
  year           Int
  sequenceNumber Int

  // Related entities
  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  noShowEventId String?      @unique
  noShowEvent   NoShowEvent? @relation(fields: [noShowEventId], references: [id])

  // Parties
  issuerId String // Artisan who issued the invoice
  issuer   User   @relation("IssuedInvoices", fields: [issuerId], references: [id])

  clientId String // Client receiving the invoice
  client   User   @relation("ReceivedInvoices", fields: [clientId], references: [id])

  // Invoice details
  type   InvoiceType
  status InvoiceStatus @default(DRAFT)

  // Amounts (all in EUR)
  subtotal    Decimal @db.Decimal(10, 2) // Amount before tax
  taxRate     Decimal @db.Decimal(5, 2) // Tax percentage (e.g., 17.00 for 17%)
  taxAmount   Decimal @db.Decimal(10, 2) // Calculated tax
  totalAmount Decimal @db.Decimal(10, 2) // Total including tax

  platformCommissionRate Decimal @db.Decimal(5, 2) // Commission percentage (e.g., 12.00)
  platformCommission     Decimal @db.Decimal(10, 2) // Commission amount
  artisanNetAmount       Decimal @db.Decimal(10, 2) // Amount artisan receives

  // Line items (JSON array of {description, quantity, unitPrice, total})
  lineItems Json

  // Addresses
  issuerAddress Json // {name, address, city, postalCode, country, siret, vat}
  clientAddress Json // {name, address, city, postalCode, country}

  // Payment info
  paymentDueDate DateTime?
  paidAt         DateTime?

  // PDF storage
  pdfUrl String? // S3 URL to generated PDF

  // Notes
  notes String?

  // Timestamps
  issueDate DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, sequenceNumber])
  @@index([invoiceNumber])
  @@index([issuerId])
  @@index([clientId])
  @@index([status])
  @@index([missionId])
  @@index([orderId])
  @@index([issueDate])
}

// Invoice numbering sequence (per year)
model InvoiceSequence {
  id           String   @id @default(uuid())
  year         Int      @unique
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// ================================
// NO-SHOW MANAGEMENT
// ================================

enum NoShowStatus {
  REPORTED // Artisan reported no-show
  PENDING_REVIEW // Awaiting admin validation
  VALIDATED // No-show confirmed
  REJECTED // No-show rejected (client was there)
  COMPENSATED // Artisan compensated for travel
}

model NoShowEvent {
  id        String  @id @default(uuid())
  missionId String  @unique
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  artisanId String
  artisan   User    @relation(fields: [artisanId], references: [id])

  // Proof requirements
  arrivalTime         DateTime
  waitDurationMinutes Int // Minimum 15 minutes required
  contactAttempts     Json // Array of contact attempt timestamps & methods
  proofPhotos         String[] // Photos of location, door, etc.
  gpsCoords           Json // Lat/lng proof of arrival

  // Fee & Compensation
  feeAmount          Decimal   @db.Decimal(10, 2) // 50€ emergency, 30€ scheduled
  compensationPaid   Boolean   @default(false)
  compensationPaidAt DateTime?

  // Review
  status      NoShowStatus @default(REPORTED)
  reviewedBy  String? // Admin who reviewed
  reviewNotes String?

  // Invoice relation
  invoice Invoice?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  validatedAt DateTime?

  @@index([artisanId])
  @@index([status])
  @@index([createdAt])
}

// ================================
// REPUTATION SYSTEM
// ================================

enum ReputationAction {
  MISSION_COMPLETED // +10 points
  MISSION_CANCELLED // -5 points
  NO_SHOW // -10 points
  DISPUTE_LOST // -20 points
  DISPUTE_WON // +5 points
  EXCELLENT_REVIEW // +15 points (5 stars)
  POOR_REVIEW // -10 points (1-2 stars)
  ADMIN_ADJUSTMENT // Manual adjustment
}

model ReputationProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  totalPoints        Int      @default(100) // Score 0-200 (100 = neutral)
  totalMissions      Int      @default(0)
  successfulMissions Int      @default(0)
  cancelledMissions  Int      @default(0)
  noShowCount        Int      @default(0)
  averageRating      Decimal  @default(0) @db.Decimal(3, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([totalPoints])
}

model ReputationHistory {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  action           ReputationAction
  pointsChange     Int // Can be positive or negative
  previousScore    Int
  newScore         Int
  reason           String?
  relatedMissionId String?
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ================================
// PLATFORM COST TRACKING
// ================================

enum CompensationReason {
  CLIENT_CHANGED_MIND // Client refunded + artisan paid
  CLIENT_EMERGENCY_RESOLVED
  CLIENT_NO_SHOW
  PLATFORM_ERROR
  GOODWILL_GESTURE
}

model CompensationLog {
  id             String             @id @default(uuid())
  userId         String // Artisan who received compensation
  user           User               @relation(fields: [userId], references: [id])
  missionId      String?
  reason         CompensationReason
  amount         Decimal            @db.Decimal(10, 2)
  clientRefunded Boolean            @default(false) // True if we also refunded client
  refundAmount   Decimal?           @db.Decimal(10, 2)
  totalCost      Decimal            @db.Decimal(10, 2) // amount + refundAmount
  notes          String?
  createdAt      DateTime           @default(now())

  @@index([userId])
  @@index([reason])
  @@index([createdAt])
}

// ================================
// MESSAGING
// ================================

model Message {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content     String
  attachments String[]
  read        Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, receiverId])
  @@index([createdAt])
  // Additional composite index for conversation queries
  @@index([senderId, receiverId, createdAt])
}

// Content Moderation - Violation tracking
model ContentViolation {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation("ContentViolations", fields: [userId], references: [id], onDelete: Cascade)
  content          String // Stored for admin review (first 500 chars)
  detectedPatterns String[] // Array of pattern names that matched
  severity         String // LOW, MEDIUM, HIGH
  reviewed         Boolean   @default(false)
  reviewedBy       String?
  reviewedAt       DateTime?
  actionTaken      String? // WARNING, ACCOUNT_SUSPENDED, etc.
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([severity])
  @@index([reviewed])
  @@index([createdAt])
}

// ================================
// FRAUD PROTECTION - FEATURE TOGGLES
// ================================

model FraudProtectionConfig {
  id String @id @default(uuid())

  // Multi-Account Detection
  multiAccountDetectionEnabled Boolean @default(true)
  multiAccountRiskThreshold    Int     @default(70) // 0-100

  // Review Fraud Detection
  reviewFraudDetectionEnabled Boolean @default(true)
  reviewFraudScoreThreshold   Float   @default(70) // 0-100
  reviewAutoHideEnabled       Boolean @default(true)

  // Payout Fraud Screening
  payoutFraudScreeningEnabled Boolean @default(true)
  payoutRiskThreshold         Int     @default(60) // 0-100
  payoutAutoHoldEnabled       Boolean @default(true)

  // Price Anomaly Detection
  priceAnomalyDetectionEnabled Boolean @default(true)
  priceDeviationThreshold      Int     @default(-30) // Percentage
  priceAutoFlagEnabled         Boolean @default(true)

  // Refund Abuse Detection
  refundAbuseDetectionEnabled Boolean @default(true)
  refundAbuseScoreThreshold   Int     @default(60) // 0-100
  refundAutoRejectEnabled     Boolean @default(false)

  // Session Anomaly Detection
  sessionAnomalyDetectionEnabled Boolean @default(true)
  sessionThreatLevelThreshold    String  @default("HIGH") // LOW, MEDIUM, HIGH, CRITICAL
  sessionAutoLogoutEnabled       Boolean @default(true)

  // KYC/AML
  kycEnabled                    Boolean @default(true)
  kycSingleTransactionThreshold Int     @default(1000) // EUR
  kycCumulativeThreshold        Int     @default(3000) // EUR/month
  kycAutoBlockEnabled           Boolean @default(true)

  // Bot Detection
  botDetectionEnabled Boolean @default(true)
  botScoreThreshold   Int     @default(70) // 0-100
  botCaptchaEnabled   Boolean @default(true)

  // Business Verification
  businessVerificationRequired   Boolean @default(true)
  businessVerificationAutoReject Boolean @default(false)

  // Global Settings
  fraudAlertEmailEnabled Boolean @default(true)
  fraudAlertEmail        String  @default("admin@articonnect.com")

  updatedAt DateTime @updatedAt
  updatedBy String? // Admin user ID who last updated

  @@map("fraud_protection_config")
}

// ================================
// NOTIFICATIONS
