// ArtiConnect - Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// USERS & AUTHENTICATION
// ================================

enum UserRole {
  CLIENT
  ARTISAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  phone    String?    @unique
  password String
  role     UserRole   @default(CLIENT)
  status   UserStatus @default(ACTIVE)

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // Encrypted

  // Profil
  firstName String
  lastName  String
  avatar    String? // URL S3
  fcmTokens String[] @default([]) // Firebase Cloud Messaging tokens for push notifications

  // Outlook Calendar Integration
  outlookAccessToken  String? // OAuth access token for Microsoft Graph API
  outlookRefreshToken String? // OAuth refresh token
  outlookTokenExpiry  DateTime? // Token expiration timestamp

  // Metadata
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  phoneVerified   Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Reputation & Payment Trust System
  reputationScore   Int     @default(100) // Score 0-200 (100 = neutral)
  completedMissions Int     @default(0)
  noShowCount       Int     @default(0)
  disputeCount      Int     @default(0)
  disputeRate       Decimal @default(0) @db.Decimal(5, 2) // Percentage

  // Relations
  clientProfile    ClientProfile?
  artisanProfile   ArtisanProfile?
  refreshTokens    RefreshToken[]
  backupCodes      BackupCode[]
  consents         UserConsent?
  notifications    Notification[]
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")

  // Missions
  clientMissions  Mission[] @relation("ClientMissions")
  artisanMissions Mission[] @relation("ArtisanMissions")

  // Reviews
  givenReviews    Review[]         @relation("GivenReviews")
  receivedReviews Review[]         @relation("ReceivedReviews")
  reviewResponses ReviewResponse[] @relation("ReviewResponses")

  // Disputes
  disputesCreated  Dispute[] @relation("DisputesCreated")
  disputesResolved Dispute[] @relation("DisputesResolved")

  // Marketplace
  products Product[]
  orders   Order[]
  returns  OrderReturn[] @relation("ClientReturns")

  // Saved by clients
  savedByClients SavedArtisan[]

  // Payment & Reputation System
  noShowEvents      NoShowEvent[]
  reputationHistory ReputationHistory[]
  compensationLogs  CompensationLog[]
  payments          Payment[]

  // Favorites & Requests
  favorites        Favorite[]
  favoriteArtisans Favorite[] @relation("FavoriteArtisans")
  clientRequests   Request[]  @relation("ClientRequests")
  artisanRequests  Request[]  @relation("ArtisanRequests")

  // Invoices
  issuedInvoices   Invoice[] @relation("IssuedInvoices")
  receivedInvoices Invoice[] @relation("ReceivedInvoices")

  // VAT declarations
  vatDeclarations VatDeclaration[]

  // Reports
  reportsMade     Report[] @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")
  reportsResolved Report[] @relation("ReportsResolved")

  // Content Moderation
  contentViolations ContentViolation[] @relation("ContentViolations")

  // Fraud Detection & Security
  // Multi-Account Detection
  deviceFingerprints      String[]  @default([]) // Array of device fingerprint IDs
  lastUserAgent           String?
  lastIpAddress           String?
  multiAccountRiskScore   Int       @default(0) // 0-100
  multiAccountFlagged     Boolean   @default(false)
  multiAccountReviewedAt  DateTime?

  // KYC/AML Compliance
  kycVerified             Boolean   @default(false)
  kycVerifiedAt           DateTime?
  kycStatus               String    @default("PENDING") // PENDING, VERIFIED, REJECTED, REQUIRED
  kycProvider             String?   // STRIPE_IDENTITY, ONFIDO, etc.
  kycSessionId            String?

  // Refund Abuse Tracking
  refundCount             Int       @default(0)
  refundRate              Decimal   @default(0) @db.Decimal(5, 2) // Percentage
  refundAbuseScore        Int       @default(0) // 0-100
  refundBlocked           Boolean   @default(false)

  // Session Security
  lastSessionId           String?
  lastSessionLocation     String?   // "lat,lng"
  sessionAnomalyCount     Int       @default(0)

  // Bot Detection
  botDetectionScore       Int       @default(0) // 0-100
  botFlagged              Boolean   @default(false)
  captchaRequired         Boolean   @default(false)

  // Badges
  badges UserBadge[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([reputationScore])
  @@index([multiAccountRiskScore])
  @@index([kycStatus])
}

model ClientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Addresses
  addresses Address[]

  // Payment
  stripeCustomerId     String? @unique
  defaultPaymentMethod String?

  // Deferred Payment (Professional Clients)
  deferredPaymentEnabled Boolean @default(false) // Pro client with payment terms
  paymentTermDays        Int     @default(30) // Net-30, Net-60, etc.
  creditLimit            Decimal @default(0) @db.Decimal(10, 2) // Maximum outstanding amount
  currentOutstanding     Decimal @default(0) @db.Decimal(10, 2) // Current unpaid invoices
  lastCreditReview       DateTime? // Last time credit was reviewed
  deferredPaymentNotes   String? // Internal notes about payment terms

  // Favoris
  savedArtisans SavedArtisan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArtisanProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Business info
  companyName String
  siret       String  @unique
  vatNumber   String? // Encrypted
  description String?
  website     String?

  // Specialties
  specialties Specialty[]

  // Service area
  serviceRadius Int    @default(20) // km
  baseAddress   String
  latitude      Float
  longitude     Float

  // Pricing
  hourlyRate    Decimal? @db.Decimal(10, 2)
  emergencyRate Decimal? @db.Decimal(10, 2)

  // Documents
  insurance      String? // URL
  certifications Certification[]

  // Stripe Connect
  stripeAccountId String? @unique
  stripeOnboarded Boolean @default(false)

  // Business Verification (Multi-country: FR/LU/BE)
  businessVerified               Boolean   @default(false)
  businessVerifiedAt             DateTime?
  businessVerificationStatus     String    @default("PENDING") // PENDING, VERIFIED, REJECTED, MANUAL_REVIEW
  businessRegistrationNumber     String?   // SIRET (FR), RCS (LU), KBO (BE)
  businessCountry                String?   // FR, LU, BE
  businessVerificationErrors     String[]  @default([])
  businessVerificationWarnings   String[]  @default([])
  businessLegalForm              String?   // SARL, SPRL, S.à r.l., etc.
  businessActivityCode           String?   // NAF (FR), NACE (BE/LU)
  businessVerificationLastCheck  DateTime?

  // Stats
  rating       Decimal @default(0) @db.Decimal(3, 2)
  reviewCount  Int     @default(0)
  missionCount Int     @default(0)

  // Availability
  available          Boolean   @default(true)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?

  // Calendar & Availability
  workingHours            WorkingHours[]
  availabilitySlots       AvailabilitySlot[]
  timeOffs                TimeOff[]
  recurringUnavailability RecurringUnavailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([rating])
}

model Address {
  id         String        @id @default(uuid())
  clientId   String
  client     ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label      String // "Home", "Work"
  street     String
  city       String
  postalCode String
  country    String // "LU", "FR", "BE"
  latitude   Float
  longitude  Float
  isDefault  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([clientId])
  @@index([latitude, longitude])
}

model Specialty {
  id          String           @id @default(uuid())
  name        String           @unique
  category    String
  description String?
  icon        String?
  artisans    ArtisanProfile[]
  createdAt   DateTime         @default(now())
}

model Certification {
  id         String         @id @default(uuid())
  artisanId  String
  artisan    ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  name       String
  issuer     String
  issueDate  DateTime
  expiryDate DateTime?
  document   String?
  verified   Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

model SavedArtisan {
  id        String        @id @default(uuid())
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisanId String
  artisan   User          @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([clientId, artisanId])
}

// ================================
// MISSIONS
// ================================

enum MissionType {
  EMERGENCY // Urgent
  SCHEDULED // Planned
  QUOTE // Quote request
}

enum MissionStatus {
  PENDING
  NEGOTIATING
  ACCEPTED
  PENDING_DEPOSIT // NEW: Waiting for deposit payment
  DEPOSIT_PAID // NEW: Deposit paid, ready for artisan travel
  IN_TRANSIT // NEW: Artisan traveling to client
  PAID
  IN_PROGRESS
  COMPLETED
  AUTO_VALIDATED // NEW: Auto-validated after 7 days timeout
  CANCELLED
  CANCELLED_NO_SHOW // NEW: Cancelled because client was unavailable
  DISPUTED
}

model Mission {
  id          String        @id @default(uuid())
  clientId    String
  client      User          @relation("ClientMissions", fields: [clientId], references: [id])
  artisanId   String?
  artisan     User?         @relation("ArtisanMissions", fields: [artisanId], references: [id])
  type        MissionType
  status      MissionStatus @default(PENDING)
  title       String
  description String
  category    String

  // Location
  address    String
  city       String
  postalCode String
  country    String
  latitude   Float
  longitude  Float

  // Scheduling
  scheduledFor      DateTime?
  estimatedDuration Int? // minutes

  // Pricing
  clientBudget Decimal? @db.Decimal(10, 2)
  artisanQuote Decimal? @db.Decimal(10, 2)
  agreedPrice  Decimal? @db.Decimal(10, 2)
  finalPrice   Decimal? @db.Decimal(10, 2)
  vatRate      Decimal  @db.Decimal(5, 2)
  totalAmount  Decimal? @db.Decimal(10, 2)

  // Hybrid Payment System (Reputation-based)
  depositRequired     Boolean   @default(false)
  depositPercentage   Int       @default(30) // 30%, 50%, or 100%
  depositAmount       Decimal?  @db.Decimal(10, 2)
  depositPaidAt       DateTime?
  retractionExpiresAt DateTime? // 48h after completion
  autoValidated       Boolean   @default(false) // True if auto-validated after 7 days

  // Price Anomaly Detection
  priceAnomalyFlag      Boolean   @default(false) // Flagged as suspicious pricing
  expectedPrice         Decimal?  @db.Decimal(10, 2) // ML-predicted fair price
  priceDeviation        Int?      // Percentage deviation from norm (-100 to +100)
  priceAnomalySignals   String[]  @default([]) // Array of anomaly signals
  priceReviewedAt       DateTime? // When price was reviewed
  priceReviewedBy       String?   // Admin who reviewed

  // Media
  photos String[]

  // Radius Expansion (automatic search expansion when no artisan responds)
  initialSearchRadius   Int      @default(20) // Initial search radius in km
  currentSearchRadius   Int      @default(20) // Current search radius in km
  lastRadiusExpansion   DateTime? // When radius was last expanded
  maxRadiusReached      Boolean  @default(false) // True if max radius (100km) reached
  notificationsSent     Int      @default(0) // Track number of artisans notified

  // Relations
  negotiations        Negotiation[]
  transaction         Transaction?
  payments            Payment[]
  review              Review?
  disputes            Dispute[]
  history             MissionHistory[]
  noShowEvent         NoShowEvent?
  invoices            Invoice[]
  reports             Report[]
  availabilitySlots   AvailabilitySlot[]

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  acceptedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  arrivedAt       DateTime? // NEW: When artisan arrived at client location
  validatedAt     DateTime? // NEW: When client validated work (or 48h passed)
  autoValidatedAt DateTime? // NEW: When system auto-validated (7-day timeout)

  @@index([clientId])
  @@index([artisanId])
  @@index([status])
  @@index([type])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@index([completedAt]) // NEW: For auto-validation CRON job
}

model MissionHistory {
  id            String        @id @default(uuid())
  missionId     String
  mission       Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  status        MissionStatus
  changedBy     String // userId who made the change
  changedByRole String // ARTISAN, CLIENT, or ADMIN
  note          String? // Optional note about the change
  createdAt     DateTime      @default(now())

  @@index([missionId])
  @@index([createdAt])
}

model Negotiation {
  id             String    @id @default(uuid())
  missionId      String
  mission        Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  senderId       String
  receiverId     String
  proposedPrice  Decimal   @db.Decimal(10, 2)

  // Price breakdown (optional detailed pricing)
  laborCost      Decimal?  @db.Decimal(10, 2) // Main d'œuvre
  materialCost   Decimal?  @db.Decimal(10, 2) // Matériel
  travelCost     Decimal?  @db.Decimal(10, 2) // Déplacement

  message        String?
  accepted       Boolean?
  rejectedReason String?
  expiresAt      DateTime? // Timeout for negotiation (24h standard, 15min emergency)
  createdAt      DateTime  @default(now())

  @@index([missionId])
  @@index([expiresAt])
}

// ================================
// REVIEWS
// ================================

enum ReviewType {
  CLIENT_TO_ARTISAN // Client evaluates artisan's work
  ARTISAN_TO_CLIENT // Artisan evaluates client's behavior
}

model Review {
  id                  String          @id @default(uuid())
  missionId           String          @unique
  mission             Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  reviewerId          String
  reviewer            User            @relation("GivenReviews", fields: [reviewerId], references: [id])
  reviewedId          String
  reviewed            User            @relation("ReceivedReviews", fields: [reviewedId], references: [id])

  // Review type (bidirectional reviews)
  reviewType          ReviewType      @default(CLIENT_TO_ARTISAN)

  // Common ratings (1-5 stars)
  overallRating       Int
  qualityRating       Int? // Work quality (artisan) / Request clarity (client)
  punctualityRating   Int? // On-time arrival (artisan) / Availability (client)
  communicationRating Int? // Communication quality (both)
  valueRating         Int? // Value for money (artisan) / Fair pricing expectations (client)

  // Artisan→Client specific ratings
  paymentPromptness   Int? // Client paid on time (1-5)
  respectRating       Int? // Client was respectful and professional (1-5)
  safetyRating        Int? // Work environment was safe (1-5)

  comment             String?
  photos              String[]
  helpful             Int             @default(0)
  verified            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  ReviewResponse      ReviewResponse?
  reports             Report[]

  // Fraud Detection
  fraudScore          Float           @default(0) // 0-100
  fraudSignals        String[]        @default([]) // Array of detected fraud signals
  aiGenerated         Boolean         @default(false) // AI-generated text detection
  hidden              Boolean         @default(false) // Hidden due to fraud
  hiddenReason        String?         // Why the review was hidden
  fraudReviewedAt     DateTime?       // When fraud review was done
  fraudReviewedBy     String?         // Admin who reviewed

  @@index([reviewedId])
  @@index([fraudScore])
  @@index([hidden])
  @@index([overallRating])
  @@index([reviewType])
}

// Review Responses - Allow artisans to respond to reviews
model ReviewResponse {
  id          String   @id @default(uuid())
  reviewId    String   @unique
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  responderId String
  responder   User     @relation("ReviewResponses", fields: [responderId], references: [id])
  response    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([responderId])
}

// ================================
// DISPUTES
// ================================

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
  CANCELLED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Dispute {
  id           String          @id @default(uuid())
  missionId    String
  mission      Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User            @relation("DisputesCreated", fields: [createdById], references: [id])
  reason       String
  description  String
  status       DisputeStatus   @default(OPEN)
  priority     DisputePriority @default(MEDIUM)
  resolution   String?
  resolvedById String?
  resolvedBy   User?           @relation("DisputesResolved", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([missionId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
}

// ================================
// MARKETPLACE
// ================================

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SOLD_OUT
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  parentId    String?
  parent      Category? @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  products    Product[]
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([parentId])
  @@index([active])
}

model Product {
  id          String           @id @default(uuid())
  artisanId   String
  artisan     User             @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  name        String
  description String
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  photos      String[]
  price       Decimal          @db.Decimal(10, 2)
  vatRate     Decimal          @db.Decimal(5, 2)
  stock       Int
  sku         String?          @unique
  status      ProductStatus    @default(DRAFT)
  variants    ProductVariant[]
  orderItems  OrderItem[]
  returnItems ReturnItem[]     @relation("ReturnItems")
  favorites   Favorite[]
  reports     Report[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([artisanId])
  @@index([status])
  @@index([categoryId])
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2)
  stock           Int
  createdAt       DateTime @default(now())

  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  clientId        String
  client          User          @relation(fields: [clientId], references: [id])
  items           OrderItem[]
  returns         OrderReturn[] @relation("OrderReturns")
  subtotal        Decimal       @db.Decimal(10, 2)
  vat             Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  shippingAddress String
  shippingCost    Decimal       @default(0) @db.Decimal(10, 2)
  trackingNumber  String?
  status          OrderStatus   @default(PENDING)
  transaction     Transaction?
  invoices        Invoice[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  @@index([clientId])
  @@index([status])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RETURN_SHIPPED
  RECEIVED
  REFUNDED
  COMPLETED
}

model OrderReturn {
  id               String       @id @default(uuid())
  orderId          String
  order            Order        @relation("OrderReturns", fields: [orderId], references: [id])
  clientId         String
  client           User         @relation("ClientReturns", fields: [clientId], references: [id])
  items            ReturnItem[]
  reason           ReturnReason
  description      String?
  status           ReturnStatus @default(REQUESTED)

  // Shipping info
  returnLabel      String? // URL to return shipping label
  trackingNumber   String?

  // Refund info
  refundAmount     Decimal      @db.Decimal(10, 2)
  refundedAmount   Decimal      @default(0) @db.Decimal(10, 2)

  // Evidence
  photos           String[]     @default([])

  // Admin handling
  reviewedBy       String?
  reviewedAt       DateTime?
  resolution       String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  approvedAt       DateTime?
  completedAt      DateTime?

  @@index([orderId])
  @@index([clientId])
  @@index([status])
}

model ReturnItem {
  id            String      @id @default(uuid())
  returnId      String
  return        OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId   String
  productId     String
  product       Product     @relation("ReturnItems", fields: [productId], references: [id])
  quantity      Int
  reason        String?

  @@index([returnId])
}

// ================================
// PAYMENTS
// ================================

enum TransactionType {
  MISSION
  PRODUCT
  REFUND
  DEPOSIT // NEW: Deposit payment (partial)
  COMPENSATION // NEW: Platform compensation to artisan
}

enum TransactionStatus {
  PENDING
  HELD
  COMPLETED
  FAILED
  REFUNDED
}

model Transaction {
  id                    String            @id @default(uuid())
  type                  TransactionType
  missionId             String?           @unique
  mission               Mission?          @relation(fields: [missionId], references: [id])
  orderId               String?           @unique
  order                 Order?            @relation(fields: [orderId], references: [id])
  amount                Decimal           @db.Decimal(10, 2)
  currency              String            @default("EUR")
  commission            Decimal           @db.Decimal(10, 2)
  artisanAmount         Decimal           @db.Decimal(10, 2)

  // Stripe payment fields
  stripePaymentIntentId String?           @unique
  stripeTransferId      String?           @unique

  // PayPal payment fields
  paypalOrderId         String?           @unique
  paypalCaptureId       String?           @unique

  // Payment method tracking
  paymentMethod         PaymentMethod     @default(STRIPE)

  status                TransactionStatus @default(PENDING)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  completedAt           DateTime?
  refundedAt            DateTime?

  @@index([status])
  @@index([type])
  @@index([paymentMethod])
}

// ================================
// PAYMENT DETAILS (Hybrid System)
// ================================

enum PaymentType {
  DEPOSIT // Partial payment before travel
  FULL_PAYMENT // Complete payment after work
  REFUND // Money returned to client
  COMPENSATION // Platform pays artisan for client fault
}

enum RefundReason {
  CHANGED_MIND // Client fault → Artisan compensated
  EMERGENCY_RESOLVED // Client fault → Artisan compensated
  WORK_NOT_DONE // Artisan fault → Artisan NOT paid
  WORK_INCOMPLETE // Artisan fault → Partial refund
  MUTUAL_CANCELLATION // Neutral → Compensation if traveling
  ARTISAN_NO_SHOW // Artisan fault → Full refund
  CLIENT_NO_SHOW // Client fault → Artisan compensated
}

enum PaymentMethod {
  STRIPE // Credit/debit card via Stripe
  PAYPAL // PayPal account
  BANK_TRANSFER // Manual bank transfer
  SEPA // SEPA Direct Debit (European bank transfer)
  DEFERRED // B2B deferred payment (Net-30/60/90)
}

model Payment {
  id        String      @id @default(uuid())
  missionId String
  mission   Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId    String // Who made the payment
  user      User        @relation(fields: [userId], references: [id])
  type      PaymentType
  amount    Decimal     @db.Decimal(10, 2)

  // Refund tracking
  refundReason   RefundReason?
  refundedAmount Decimal?      @db.Decimal(10, 2)
  refundedAt     DateTime?

  // Compensation tracking (when platform absorbs cost)
  artisanCompensated   Boolean  @default(false)
  compensationAmount   Decimal? @db.Decimal(10, 2)
  platformAbsorbedCost Boolean  @default(false) // True when we pay both client + artisan

  // Retraction period tracking
  withinRetractionPeriod Boolean   @default(false)
  retractionExpiresAt    DateTime?

  // Payment method tracking
  paymentMethod PaymentMethod @default(STRIPE)

  // Stripe
  stripePaymentIntentId String? @unique
  stripeRefundId        String? @unique

  // PayPal
  paypalOrderId   String? @unique
  paypalCaptureId String? @unique
  paypalRefundId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([missionId])
  @@index([userId])
  @@index([type])
  @@index([paymentMethod])
}

// ================================
// INVOICING
// ================================

enum InvoiceType {
  MISSION // Mission invoice
  MARKETPLACE // Marketplace order invoice
  NO_SHOW_FEE // No-show fee invoice
}

enum InvoiceStatus {
  DRAFT // Being prepared
  ISSUED // Sent to client
  PAID // Payment received
  OVERDUE // Past due date (for deferred payments)
  CANCELLED // Cancelled
  REFUNDED // Refunded
}

model Invoice {
  id String @id @default(uuid())

  // Invoice numbering (e.g. INV-2025-00001)
  invoiceNumber String @unique
  year          Int
  sequenceNumber Int

  // Related entities
  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  noShowEventId String?      @unique
  noShowEvent   NoShowEvent? @relation(fields: [noShowEventId], references: [id])

  // Parties
  issuerId String // Artisan who issued the invoice
  issuer   User   @relation("IssuedInvoices", fields: [issuerId], references: [id])

  clientId String // Client receiving the invoice
  client   User   @relation("ReceivedInvoices", fields: [clientId], references: [id])

  // Invoice details
  type        InvoiceType
  status      InvoiceStatus @default(DRAFT)

  // Amounts (all in EUR)
  subtotal         Decimal @db.Decimal(10, 2) // Amount before tax
  taxRate          Decimal @db.Decimal(5, 2)  // Tax percentage (e.g., 17.00 for 17%)
  taxAmount        Decimal @db.Decimal(10, 2) // Calculated tax
  totalAmount      Decimal @db.Decimal(10, 2) // Total including tax

  platformCommissionRate Decimal @db.Decimal(5, 2) // Commission percentage (e.g., 12.00)
  platformCommission     Decimal @db.Decimal(10, 2) // Commission amount
  artisanNetAmount       Decimal @db.Decimal(10, 2) // Amount artisan receives

  // Line items (JSON array of {description, quantity, unitPrice, total})
  lineItems Json

  // Addresses
  issuerAddress Json // {name, address, city, postalCode, country, siret, vat}
  clientAddress Json // {name, address, city, postalCode, country}

  // Payment info
  paymentDueDate DateTime?
  paidAt         DateTime?

  // PDF storage
  pdfUrl String? // S3 URL to generated PDF

  // Notes
  notes String?

  // Timestamps
  issueDate DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, sequenceNumber])
  @@index([invoiceNumber])
  @@index([issuerId])
  @@index([clientId])
  @@index([status])
  @@index([missionId])
  @@index([orderId])
  @@index([issueDate])
}

// Invoice numbering sequence (per year)
model InvoiceSequence {
  id             String @id @default(uuid())
  year           Int    @unique
  lastSequence   Int    @default(0)
  updatedAt      DateTime @updatedAt
}

// ================================
// NO-SHOW MANAGEMENT
// ================================

enum NoShowStatus {
  REPORTED // Artisan reported no-show
  PENDING_REVIEW // Awaiting admin validation
  VALIDATED // No-show confirmed
  REJECTED // No-show rejected (client was there)
  COMPENSATED // Artisan compensated for travel
}

model NoShowEvent {
  id        String  @id @default(uuid())
  missionId String  @unique
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  artisanId String
  artisan   User    @relation(fields: [artisanId], references: [id])

  // Proof requirements
  arrivalTime         DateTime
  waitDurationMinutes Int // Minimum 15 minutes required
  contactAttempts     Json // Array of contact attempt timestamps & methods
  proofPhotos         String[] // Photos of location, door, etc.
  gpsCoords           Json // Lat/lng proof of arrival

  // Fee & Compensation
  feeAmount          Decimal   @db.Decimal(10, 2) // 50€ emergency, 30€ scheduled
  compensationPaid   Boolean   @default(false)
  compensationPaidAt DateTime?

  // Review
  status      NoShowStatus @default(REPORTED)
  reviewedBy  String? // Admin who reviewed
  reviewNotes String?

  // Invoice relation
  invoice Invoice?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  validatedAt DateTime?

  @@index([artisanId])
  @@index([status])
  @@index([createdAt])
}

// ================================
// REPUTATION SYSTEM
// ================================

enum ReputationAction {
  MISSION_COMPLETED // +10 points
  MISSION_CANCELLED // -5 points
  NO_SHOW // -10 points
  DISPUTE_LOST // -20 points
  DISPUTE_WON // +5 points
  EXCELLENT_REVIEW // +15 points (5 stars)
  POOR_REVIEW // -10 points (1-2 stars)
  ADMIN_ADJUSTMENT // Manual adjustment
}

model ReputationProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  totalPoints        Int      @default(100) // Score 0-200 (100 = neutral)
  totalMissions      Int      @default(0)
  successfulMissions Int      @default(0)
  cancelledMissions  Int      @default(0)
  noShowCount        Int      @default(0)
  averageRating      Decimal  @default(0) @db.Decimal(3, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([totalPoints])
}

model ReputationHistory {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  action           ReputationAction
  pointsChange     Int // Can be positive or negative
  previousScore    Int
  newScore         Int
  reason           String?
  relatedMissionId String?
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ================================
// PLATFORM COST TRACKING
// ================================

enum CompensationReason {
  CLIENT_CHANGED_MIND // Client refunded + artisan paid
  CLIENT_EMERGENCY_RESOLVED
  CLIENT_NO_SHOW
  PLATFORM_ERROR
  GOODWILL_GESTURE
}

model CompensationLog {
  id             String             @id @default(uuid())
  userId         String // Artisan who received compensation
  user           User               @relation(fields: [userId], references: [id])
  missionId      String?
  reason         CompensationReason
  amount         Decimal            @db.Decimal(10, 2)
  clientRefunded Boolean            @default(false) // True if we also refunded client
  refundAmount   Decimal?           @db.Decimal(10, 2)
  totalCost      Decimal            @db.Decimal(10, 2) // amount + refundAmount
  notes          String?
  createdAt      DateTime           @default(now())

  @@index([userId])
  @@index([reason])
  @@index([createdAt])
}

// ================================
// MESSAGING
// ================================

model Message {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content     String
  attachments String[]
  read        Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, receiverId])
  @@index([createdAt])
}

// Content Moderation - Violation tracking
model ContentViolation {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation("ContentViolations", fields: [userId], references: [id], onDelete: Cascade)
  content          String   // Stored for admin review (first 500 chars)
  detectedPatterns String[] // Array of pattern names that matched
  severity         String   // LOW, MEDIUM, HIGH
  reviewed         Boolean  @default(false)
  reviewedBy       String?
  reviewedAt       DateTime?
  actionTaken      String?  // WARNING, ACCOUNT_SUSPENDED, etc.
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([severity])
  @@index([reviewed])
  @@index([createdAt])
}

// ================================
// NOTIFICATIONS
// ================================

enum NotificationType {
  NEW_MISSION
  MISSION_ACCEPTED
  MISSION_COMPLETED
  MISSION_CANCELLED
  NEGOTIATION_NEW
  NEGOTIATION_ACCEPTED
  NEGOTIATION_REJECTED
  PAYMENT_RECEIVED
  REVIEW_NEW
  MESSAGE_NEW
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  metadata  Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model NotificationPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  newMission         Boolean  @default(true)
  missionUpdate      Boolean  @default(true)
  newMessage         Boolean  @default(true)
  paymentReceived    Boolean  @default(true)
  paymentSent        Boolean  @default(true)
  reviewReceived     Boolean  @default(true)
  marketingEmails    Boolean  @default(false)
  weeklyDigest       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

// ================================
// AUTH
// ================================

model RefreshToken {
  id         String   @id @default(uuid())
  token      String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String?
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model BackupCode {
  id        String    @id @default(uuid())
  code      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PhoneVerificationToken {
  id        String   @id @default(uuid())
  code      String // 6-digit verification code
  phone     String // Phone number to verify
  userId    String? // Optional: if user is already logged in
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0) // Track failed attempts
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([code])
}

// ================================
// GDPR
// ================================

model UserConsent {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketing   Boolean  @default(false)
  analytics   Boolean  @default(false)
  geolocation Boolean  @default(false)
  emailNotif  Boolean  @default(true)
  smsNotif    Boolean  @default(false)
  pushNotif   Boolean  @default(true)
  consentDate DateTime @default(now())
  ipAddress   String
  updatedAt   DateTime @updatedAt
}

// ================================
// TVA / VAT MANAGEMENT
// ================================

enum ServiceCategory {
  EMERGENCY // Dépannage d'urgence
  RENOVATION // Travaux de rénovation
  INSTALLATION // Installation
  MAINTENANCE // Maintenance
  PRODUCT // Vente de produits
  OTHER // Autres
}

model Country {
  id   String @id @default(uuid())
  code String @unique // LU, FR, BE
  name String

  // Standard tax rates for this country
  standardRate      Decimal @db.Decimal(5, 2) // e.g., 17.00
  reducedRate       Decimal @db.Decimal(5, 2) // e.g., 8.00
  intermediateRate  Decimal? @db.Decimal(5, 2) // e.g., 14.00
  superReducedRate  Decimal? @db.Decimal(5, 2) // e.g., 3.00

  // VAT configuration
  taxRates TaxRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model TaxRate {
  id        String @id @default(uuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  // Service category this rate applies to
  category ServiceCategory

  // Tax rate percentage
  rate Decimal @db.Decimal(5, 2)

  // Description
  description String?

  // Effective dates
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([category])
  @@index([effectiveFrom])
}

// VAT declaration tracking (for future use)
model VatDeclaration {
  id        String @id @default(uuid())
  artisanId String
  artisan   User   @relation(fields: [artisanId], references: [id])

  period      String // e.g., "2025-Q1" or "2025-01"
  countryCode String // LU, FR, BE

  // Amounts
  totalSales      Decimal @db.Decimal(10, 2)
  totalTax        Decimal @db.Decimal(10, 2)
  totalPurchases  Decimal? @db.Decimal(10, 2)
  totalTaxCredit  Decimal? @db.Decimal(10, 2)
  netTaxDue       Decimal @db.Decimal(10, 2)

  // Status
  status      String   @default("DRAFT") // DRAFT, SUBMITTED, PAID
  submittedAt DateTime?
  paidAt      DateTime?

  // File references
  reportUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artisanId, period, countryCode])
  @@index([artisanId])
  @@index([period])
  @@index([status])
}

// ================================
// MODERATION & REPORTS
// ================================

enum ReportType {
  REVIEW
  PRODUCT
  USER
  MISSION
  MESSAGE
}

enum ReportReason {
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT
  FAKE_REVIEW
  COUNTERFEIT_PRODUCT
  FRAUD
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation("ReportsMade", fields: [reporterId], references: [id])

  type        ReportType
  reason      ReportReason
  description String?

  // Reported entity (polymorphic)
  reviewId  String?
  review    Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  reportedUserId String?
  reportedUser   User? @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Status & resolution
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolver    User?    @relation("ReportsResolved", fields: [resolvedBy], references: [id])
  resolution  String?
  actionTaken String? // "USER_WARNED", "CONTENT_REMOVED", "USER_SUSPENDED", etc.

  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([type])
}

// ================================
// CALENDAR & AVAILABILITY
// ================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RecurrencePattern {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum TimeOffType {
  VACATION
  SICK_LEAVE
  PERSONAL
  PUBLIC_HOLIDAY
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

// Regular working hours (weekly schedule)
model WorkingHours {
  id         String    @id @default(uuid())
  artisanId  String
  artisan    ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  dayOfWeek  DayOfWeek
  startTime  String    // HH:mm format (e.g., "09:00")
  endTime    String    // HH:mm format (e.g., "17:00")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([artisanId, dayOfWeek])
  @@index([artisanId])
}

// Specific availability slots
model AvailabilitySlot {
  id        String   @id @default(uuid())
  artisanId String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artisanId])
  @@index([startTime])
  @@index([isBooked])
}

// Time off / Unavailability
model TimeOff {
  id          String         @id @default(uuid())
  artisanId   String
  artisan     ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  type        TimeOffType
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      TimeOffStatus  @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([artisanId])
  @@index([startDate])
  @@index([status])
}

// Recurring unavailability (e.g., "every Monday afternoon")
model RecurringUnavailability {
  id         String            @id @default(uuid())
  artisanId  String
  artisan    ArtisanProfile    @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  title      String
  pattern    RecurrencePattern
  dayOfWeek  DayOfWeek?        // For WEEKLY pattern
  dayOfMonth Int?              // For MONTHLY pattern (1-31)
  startTime  String            // HH:mm format
  endTime    String            // HH:mm format
  startDate  DateTime          // When this recurrence starts
  endDate    DateTime?         // Optional end date
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([artisanId])
  @@index([isActive])
}

// ================================
// PLATFORM CONFIGURATION
// ================================

enum ConfigCategory {
  FEES
  PAYMENT
  NOTIFICATION
  FEATURE_TOGGLE
  LIMIT
  GENERAL
}

enum ConfigDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model PlatformConfig {
  id          String         @id @default(uuid())
  key         String         @unique
  value       String         // Stored as string, parsed based on dataType
  dataType    ConfigDataType @default(STRING)
  category    ConfigCategory
  description String?
  isPublic    Boolean        @default(false) // Can be accessed by clients
  isActive    Boolean        @default(true)
  updatedBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
  @@index([isActive])
}

// ================================
// BADGES & ACHIEVEMENTS
// ================================

enum BadgeType {
  PERFORMANCE
  RELIABILITY
  EXPERIENCE
  SPECIALTY
  CUSTOMER_SERVICE
  MILESTONE
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Badge {
  id          String    @id @default(uuid())
  key         String    @unique // e.g., "missions_completed_10"
  name        String
  description String
  icon        String? // URL to badge icon
  type        BadgeType
  tier        BadgeTier

  // Criteria for earning (stored as JSON)
  criteria    Json // { "missions_completed": 10 } or { "avg_rating": 4.5, "min_reviews": 20 }

  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  userBadges  UserBadge[]

  @@index([type])
  @@index([tier])
  @@index([isActive])
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  // Optional: Track what triggered the badge
  triggerData Json?

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([earnedAt])
}

// ================================
// AUDIT
// ================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   Json?
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ================================
// FAVORITES & REQUESTS
// ================================

// Favoris (artisans ou produits)
model Favorite {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Type de favori (artisan ou produit)
  artisanId String?
  artisan   User?   @relation("FavoriteArtisans", fields: [artisanId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, artisanId])
  @@unique([userId, productId])
  @@index([userId])
  @@index([artisanId])
  @@index([productId])
}

// Demandes de devis/mission
model Request {
  id       String @id @default(uuid())
  clientId String
  client   User   @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)

  artisanId String?
  artisan   User?   @relation("ArtisanRequests", fields: [artisanId], references: [id])

  title       String
  description String
  category    String

  // Localisation
  address    String
  city       String
  postalCode String
  latitude   Float?
  longitude  Float?

  // Budget estimé
  estimatedBudget Decimal? @db.Decimal(10, 2)

  // Statut
  status String @default("PENDING") // PENDING, QUOTED, ACCEPTED, DECLINED, EXPIRED

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@index([clientId])
  @@index([artisanId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// Mission Templates - Reusable templates for common mission types
model MissionTemplate {
  id       String @id @default(uuid())
  name     String
  category String

  description       String?
  estimatedDuration Int? // minutes

  // Budget range guidance
  defaultBudgetRange String? // JSON: { min, max }

  // Skills and checklist
  requiredSkills String? // JSON array
  checklistItems String? // JSON array

  // Visibility
  isPublic Boolean @default(false)

  // Creator and usage
  createdBy  String
  usageCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
  @@index([createdBy])
  @@index([usageCount])
}
