// ================================
// TVA / VAT MANAGEMENT
// ================================

enum ServiceCategory {
  EMERGENCY // Dépannage d'urgence
  RENOVATION // Travaux de rénovation
  INSTALLATION // Installation
  MAINTENANCE // Maintenance
  PRODUCT // Vente de produits
  OTHER // Autres
}

model Country {
  id   String @id @default(uuid())
  code String @unique // LU, FR, BE
  name String

  // Standard tax rates for this country
  standardRate     Decimal  @db.Decimal(5, 2) // e.g., 17.00
  reducedRate      Decimal  @db.Decimal(5, 2) // e.g., 8.00
  intermediateRate Decimal? @db.Decimal(5, 2) // e.g., 14.00
  superReducedRate Decimal? @db.Decimal(5, 2) // e.g., 3.00

  // VAT configuration
  taxRates TaxRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model TaxRate {
  id        String  @id @default(uuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  // Service category this rate applies to
  category ServiceCategory

  // Tax rate percentage
  rate Decimal @db.Decimal(5, 2)

  // Description
  description String?

  // Effective dates
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([category])
  @@index([effectiveFrom])
}

// VAT declaration tracking (for future use)
model VatDeclaration {
  id        String @id @default(uuid())
  artisanId String
  artisan   User   @relation(fields: [artisanId], references: [id])

  period      String // e.g., "2025-Q1" or "2025-01"
  countryCode String // LU, FR, BE

  // Amounts
  totalSales     Decimal  @db.Decimal(10, 2)
  totalTax       Decimal  @db.Decimal(10, 2)
  totalPurchases Decimal? @db.Decimal(10, 2)
  totalTaxCredit Decimal? @db.Decimal(10, 2)
  netTaxDue      Decimal  @db.Decimal(10, 2)

  // Status
  status      String    @default("DRAFT") // DRAFT, SUBMITTED, PAID
  submittedAt DateTime?
  paidAt      DateTime?

  // File references
  reportUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artisanId, period, countryCode])
  @@index([artisanId])
  @@index([period])
  @@index([status])
}

// ================================
// MODERATION & REPORTS
// ================================

enum ReportType {
  REVIEW
  PRODUCT
  USER
  MISSION
  MESSAGE
}

enum ReportReason {
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT
  FAKE_REVIEW
  COUNTERFEIT_PRODUCT
  FRAUD
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id         String @id @default(uuid())
  reporterId String
  reporter   User   @relation("ReportsMade", fields: [reporterId], references: [id])

  type        ReportType
  reason      ReportReason
  description String?

  // Reported entity (polymorphic)
  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  reportedUserId String?
  reportedUser   User?   @relation("ReportsReceived", fields: [reportedUserId], references: [id])

  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Status & resolution
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolver    User?        @relation("ReportsResolved", fields: [resolvedBy], references: [id])
  resolution  String?
  actionTaken String? // "USER_WARNED", "CONTENT_REMOVED", "USER_SUSPENDED", etc.

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([type])
}

// ================================
// CALENDAR & AVAILABILITY
// ================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum RecurrencePattern {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum TimeOffType {
  VACATION
  SICK_LEAVE
  PERSONAL
  PUBLIC_HOLIDAY
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

// Regular working hours (weekly schedule)
model WorkingHours {
  id        String         @id @default(uuid())
  artisanId String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String // HH:mm format (e.g., "09:00")
  endTime   String // HH:mm format (e.g., "17:00")
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([artisanId, dayOfWeek])
  @@index([artisanId])
}

// Specific availability slots
model AvailabilitySlot {
  id        String         @id @default(uuid())
  artisanId String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean        @default(false)
  missionId String?
  mission   Mission?       @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([artisanId])
  @@index([startTime])
  @@index([isBooked])
}

// Time off / Unavailability
model TimeOff {
  id         String         @id @default(uuid())
  artisanId  String
  artisan    ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  type       TimeOffType
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     TimeOffStatus  @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([artisanId])
  @@index([startDate])
  @@index([status])
}

// Recurring unavailability (e.g., "every Monday afternoon")
model RecurringUnavailability {
  id         String            @id @default(uuid())
  artisanId  String
  artisan    ArtisanProfile    @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  title      String
  pattern    RecurrencePattern
  dayOfWeek  DayOfWeek? // For WEEKLY pattern
  dayOfMonth Int? // For MONTHLY pattern (1-31)
  startTime  String // HH:mm format
  endTime    String // HH:mm format
  startDate  DateTime // When this recurrence starts
  endDate    DateTime? // Optional end date
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([artisanId])
  @@index([isActive])
}

// ================================
// PLATFORM CONFIGURATION
// ================================

enum ConfigCategory {
  FEES
  PAYMENT
  NOTIFICATION
  FEATURE_TOGGLE
  LIMIT
  GENERAL
}

enum ConfigDataType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model PlatformConfig {
  id          String         @id @default(uuid())
  key         String         @unique
  value       String // Stored as string, parsed based on dataType
  dataType    ConfigDataType @default(STRING)
  category    ConfigCategory
  description String?
  isPublic    Boolean        @default(false) // Can be accessed by clients
  isActive    Boolean        @default(true)
  updatedBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
  @@index([isActive])
}

// ================================
// BADGES & ACHIEVEMENTS
// ================================

enum BadgeType {
  PERFORMANCE
  RELIABILITY
  EXPERIENCE
  SPECIALTY
  CUSTOMER_SERVICE
  MILESTONE
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Badge {
  id          String    @id @default(uuid())
  key         String    @unique // e.g., "missions_completed_10"
  name        String
  description String
  icon        String? // URL to badge icon
  type        BadgeType
  tier        BadgeTier

  // Criteria for earning (stored as JSON)
  criteria Json // { "missions_completed": 10 } or { "avg_rating": 4.5, "min_reviews": 20 }

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userBadges UserBadge[]

  @@index([type])
  @@index([tier])
  @@index([isActive])
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  // Optional: Track what triggered the badge
  triggerData Json?

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([earnedAt])
