# ====================================
# ARTICONNECT - PRODUCTION CONFIGURATION
# ====================================
# ⚠️ IMPORTANT: Never commit .env.production to Git!
# Copy this file to .env.production and fill in real values

# ====================================
# APPLICATION
# ====================================
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Frontend URL (for CORS) - Use your production domain
FRONTEND_URL=https://articonnect.lu

# Allowed Origins (comma-separated for multiple domains)
CORS_ORIGINS=https://articonnect.lu,https://www.articonnect.lu

# ====================================
# DATABASE (PostgreSQL)
# ====================================
# ⚠️ Use strong credentials in production!
# Recommended: PostgreSQL 14+ with SSL enabled
DATABASE_URL=postgresql://username:password@db-host:5432/articonnect?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=10000

# ====================================
# REDIS (Caching & Sessions)
# ====================================
# Recommended: Redis 6+ with TLS/SSL
REDIS_HOST=redis-host.example.com
REDIS_PORT=6380
REDIS_PASSWORD=your-strong-redis-password
REDIS_TLS_ENABLED=true
REDIS_DB=0
REDIS_KEY_PREFIX=articonnect:

# ====================================
# JWT & AUTHENTICATION
# ====================================
# ⚠️ CRITICAL: Generate strong random secrets!
# Use: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING_IN_PRODUCTION
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRATION=7d

# Two-Factor Authentication
TWO_FACTOR_ISSUER=ArtiConnect
TWO_FACTOR_WINDOW=1

# ====================================
# EMAIL SERVICE
# ====================================
# Recommended: SendGrid, Mailgun, AWS SES
EMAIL_SERVICE=sendgrid
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=apikey
EMAIL_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@articonnect.lu
EMAIL_FROM_NAME=ArtiConnect
EMAIL_REPLY_TO=support@articonnect.lu

# ====================================
# STRIPE PAYMENTS
# ====================================
# Use live keys in production (sk_live_...)
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_live_your_production_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_API_VERSION=2023-10-16

# ====================================
# AWS S3 (File Storage)
# ====================================
# Recommended: Use S3 for production file storage
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=articonnect-prod-uploads
AWS_S3_CDN_URL=https://cdn.articonnect.lu

# ====================================
# GOOGLE SERVICES
# ====================================
# Google Maps API (for geocoding)
GOOGLE_MAPS_API_KEY=your-production-google-maps-api-key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# ====================================
# FILE UPLOAD
# ====================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_DIR=./uploads

# ====================================
# RATE LIMITING
# ====================================
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL=false

# ====================================
# MONITORING & LOGGING
# ====================================
# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Application Insights / DataDog (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=
DATADOG_API_KEY=

# ====================================
# SECURITY
# ====================================
# HTTPS Only
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# Content Security Policy
CSP_ENABLED=true

# API Key for internal services (if needed)
INTERNAL_API_KEY=your-internal-api-key-for-cron-jobs

# ====================================
# CRON JOBS
# ====================================
CRON_AUTO_VALIDATE_MISSIONS=true
CRON_AUTO_VALIDATE_SCHEDULE=0 2 * * *
CRON_CLEANUP_OLD_DATA=true
CRON_CLEANUP_SCHEDULE=0 3 * * 0

# ====================================
# FEATURE FLAGS
# ====================================
FEATURE_TWO_FACTOR_AUTH=true
FEATURE_HYBRID_PAYMENT=true
FEATURE_MARKETPLACE=true
FEATURE_ANALYTICS=true
FEATURE_CHAT=true

# ====================================
# PERFORMANCE
# ====================================
CACHE_TTL=300
COMPRESSION_ENABLED=true
CLUSTER_MODE=true
CLUSTER_WORKERS=auto
